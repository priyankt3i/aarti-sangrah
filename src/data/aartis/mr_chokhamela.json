      "isChorus": true,
      "lines": [
        "आरती चोखोबाराया । भक्तशिरोमणी सदया ।",
        "विठ्ठलचरणीं लीन झालासी । पंढरीच्या महाद्वारीं ठाया ।। धृ ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "देह जरी हीन कुळीं । भाव निर्मळ विठ्ठलीं ।",
        "विठ्ठल धावे आवडीनें । चोख्याची हाक ऐकली ।। १ ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "मंगळवेढ्या बांधता तट । अस्थींतूनि विठ्ठल नाद ।",
        "नामदेवे ओळखिला । संत चोखोबा अगाध ।। २ ।।"
      ]
    }
  ],
