  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "ॐ जय सूर्य भगवान, जय हो दिनकर देवा ।",
        "जग के पालनहारे, मन से करूँ सेवा ॥",
        "ॐ जय सूर्य भगवान ॥"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "तिमिर विनाशन हारे, तुम हो सुख दाता ।",
        "सात घोड़ों के रथ पर, सोहे छवि न्यारी ॥",
        "ॐ जय सूर्य भगवान ॥ १ ॥"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "जल से अर्घ्य चढ़ाऊँ, शीश झुकाऊँ मैं ।",
        "तेज तुम्हारा पाकर, जीवन महकाऊँ ॥",
        "ॐ जय सूर्य भगवान ॥ २ ॥"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "रोग हरण कल्याणकारी, जय जय प्रभाकर ।",
        "आदित्य हृदय विहारी, संकट हर लो कर ॥",
        "ॐ जय सूर्य भगवान ॥ ३ ॥"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "भक्त जनों के स्वामी, रक्षा तुम कीजे ।",
        "सकल मनोरथ पूरण, हे प्रभु वर दीजे ॥",
        "ॐ जय सूर्य भगवान ॥ ४ ॥"
      ]
    }
  ]
}
