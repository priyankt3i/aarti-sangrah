      "lines": [
        "आरती अनंतभुजा । विठो पंढरीराजा ।।",
        "न चलती उपचार । मनें सारिली पूजा ।। धृ ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "परेस पार नाहीं । न पडे निगमा ठायीं ।।",
        "भुलला भक्तिभावें । लाहो घेतला देहीं ।। १ ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "अनिर्वाच्य शुद्ध बुद्ध । उभा राहिला नीट ।।",
        "रामाजनार्दनीं । पायीं जोडिली वीट ।। २ ।।"
      ]
    }
  ],
