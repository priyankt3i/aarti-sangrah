  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "आरती कुंजबिहारीकी ।",
        "श्रीगिरधर कृष्णमुरारीकी ॥"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "गलेमें बैजंतीमाला,",
        "बजावै मुरलि मधुर बाला ।",
        "श्रवनमें कुण्डल झलकाला,",
        "नंदके आनंद नँदलाला ॥"
      ]
    },
    {
      "id": "c2",
      "isChorus": true,
      "lines": [
        "श्रीगिरधर कृष्णमुरारीकी ॥"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "गगन सम अंग कांति काली,",
        "राधिका चमक रही आली,",
        "लतनमें ठाढ़े बनमाली,",
        "भ्रमर-सी अलक, कस्तूरी-",
        "तिलक, चंद्र-सी झलक,",
        "ललित छबि स्यामा प्यारीकी ।"
      ]
    },
    {
      "id": "c3",
      "isChorus": true,
      "lines": [
        "श्रीगिरधर कृष्णमुरारीकी ॥"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "कनकमय मोर-मुकुट बिलसै,",
        "देवता दरसनकों तरसै,",
        "गगन सों सुमन रासि बरसै,",
        "बजे मुरचंग, मधुर-",
        "मिरदंग, ग्वालिनी संग,",
        "अतुल रति गोपकुमारीकी ।"
      ]
    },
    {
      "id": "c4",
      "isChorus": true,
      "lines": [
        "श्रीगिरधर कृष्णमुरारीकी ॥"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "जहाँ ते प्रगट भई गंगा,",
        "सकल-मल-हारिणि श्रीगंगा,",
        "स्मरन ते होत मोह-भंगा,",
        "बसी सिव सीस, जटाके बीच,",
        "हरै अघ कीच,",
        "चरन छबि श्रीबनवारीकी ।"
      ]
    },
    {
      "id": "c5",
      "isChorus": true,
      "lines": [
        "श्रीगिरधर कृष्णमुरारीकी ॥"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "चमकती उज्ज्वल तट रेनू,",
        "बज रही बृन्दाबन बेनू,",
        "चहूँ दिसि गोपि ग्वाल धेनू,",
        "हँसत मृदु मंद, चाँदनी चंद,",
        "कटत भव-फंद,",
        "टेर सुनु दीन दुखारीकी ।"
      ]
    },
    {
      "id": "c6",
      "isChorus": true,
      "lines": [
        "श्रीगिरधर कृष्णमुरारीकी ॥",
        "आरती कुंजबिहारीकी ।",
        "श्रीगिरधर कृष्णमुरारीकी ॥"
      ]
    }
  ]
}