  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "आरती कीजै हनुमानललाकी ।",
        "दुष्टदलन रघुनाथ कलाकी ॥ टेक ॥"
      ],
      "transliteratedLines": [
        "Arati Kijai Hanumanalalaki ।",
        "Dushtadalana Raghunatha Kalaki ॥ Teka ॥"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "जाके बलसे गिरिवर काँपै ।",
        "रोग दोष जाके निकट न झाँपै ॥",
        "अंजनिपुत्र महा बलदाई ।",
        "संतनके प्रभु सदा सहाई ॥"
      ],
      "transliteratedLines": [
        "Jake Balase Girivara Ka~pai ।",
        "Roga Dosha Jake Nikata Na Jha~pai ॥",
        "Anjaniputra Maha Baladai ।",
        "Santanake Prabhu Sada Sahai ॥"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "दे बीरा रघुनाथ पठाये ।",
        "लंका जारि सीय सुधि लाये ॥",
        "लंका-सो कोट समुद्र-सी खाई ।",
        "जात पवनसुत बार न लाई ॥"
      ],
      "transliteratedLines": [
        "De Bira Raghunatha Pathaye ।",
        "Lanka Jari Siya Sudhi Laye ॥",
        "Lanka-so Kota Samudra-si Khai ।",
        "Jata Pavanasuta Bara Na Lai ॥"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "लंका जारि असुर संहारे ।",
        "सीतारामजीके काज सँवारे ॥",
        "लक्ष्मण मूर्छित पड़े सकारे ।",
        "आनि सजीवन प्रान उबारे ॥"
      ],
      "transliteratedLines": [
        "Lanka Jari Asura Sanhare ।",
        "Sitaramajike Kaja Sa~vare ॥",
        "Lakshmana Murchhita Pada़e Sakare ।",
        "Ani Sajivana Prana Ubare ॥"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "पैठि पताल तोरि जम-कारे ।",
        "अहिरावनकी भुजा उखारे ॥",
        "बायें भुजा असुरदल मारे ।",
        "दहिने भुजा संतजन तारे ॥"
      ],
      "transliteratedLines": [
        "Paithi Patala Tori Jama-kare ।",
        "Ahiravanaki Bhuja Ukhare ॥",
        "Bayen Bhuja Asuradala Mare ।",
        "Dahine Bhuja Santajana Tare ॥"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "सुर नर मुनि आरती उतारे ।",
        "जय जय जय हनुमान उचारे ॥",
        "कंचन थार कपूर लौ छाई ।",
        "आरति करत अंजना माई ॥"
      ],
      "transliteratedLines": [
        "Sura Nara Muni Arati Utare ।",
        "Jaya Jaya Jaya Hanumana Uchare ॥",
        "Kanchana Thara Kapura Lau Chhai ।",
        "Arati Karata Anjana Mai ॥"
      ]
    },
    {
      "id": "v6",
      "lines": [
        "जो हनुमानजीकी आरति गावै ।",
        "बसि बैकुंठ परम पद पावै ॥"
      ],
      "transliteratedLines": [
        "Jo Hanumanajiki Arati Gavai ।",
        "Basi Baikuntha Parama Pada Pavai ॥"
      ]
    }
  ],
  "transliteration": "Aarti Kijai Hanuman Lala Ki (Bajrangbali Aarti)"
}
