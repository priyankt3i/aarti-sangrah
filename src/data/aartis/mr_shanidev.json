  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय जय श्रीशनिदेवा पद्मकर शिरीं ठेवा ।",
        "आरती ओवाळितो करितो तव सेवा ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Jaya Jaya Shrishanideva Padmakara Shirin Theva ।",
        "Arati Ovaḻito Karito Tava Seva ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "सूर्यसुता शनिदेवा नीलांजनकांती ।",
        "मंदगती धावसी भक्तांच्या भ्रांती ।। १ ।।"
      ],
      "transliteratedLines": [
        "Suryasuta Shanideva Nilanjanakanti ।",
        "Mandagati Dhavasi Bhaktanchya Bhranti ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "काकवाहन तुज प्रिय लोह प्रिय अती ।",
        "तैलाभिषेक करितां संकटे हरती ।। २ ।।"
      ],
      "transliteratedLines": [
        "Kakavahana Tuja Priya Loha Priya Ati ।",
        "Tailabhisheka Karitan Sankate Harati ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "साडेसातीचा फेरा सोडविसी देवा ।",
        "चरणकमळीं ठेविली भक्तिभावे सेवा ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Sadesaticha Phera Sodavisi Deva ।",
        "Charanakamaḻin Thevili Bhaktibhave Seva ।। 3 ।।"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "दीनदयाळा शनी कृपा आम्हां करीं ।",
        "भवभय नासोनि निजपदीं उद्धरीं ।। ४ ।।"
      ],
      "transliteratedLines": [
        "Dinadayaḻa Shani Krupa Amhan Karin ।",
        "Bhavabhaya Nasoni Nijapadin Uddharin ।। 4 ।।"
      ]
    }
  ],
  "transliteration": "Shree Shanidev Aarti (Jay Jay Shri Shanideva)"
