  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय देव जय देव जय श्री गुरुदत्ता ।",
        "आरति ओवाळीता हरली भवचिन्ता ।। जय देव ।।"
      ],
      "transliteratedLines": [
        "Jaya Deva Jaya Deva Jaya Shri Gurudatta ।",
        "Arati Ovaḻita Harali Bhavachinta ।। Jaya Deva ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "त्रिगुणात्मक त्रैमूर्ती दत्त हा जाणा ।",
        "त्रिगुणी अवतार त्रैलोक्य राणा ।",
        "नेती नेती शब्द न ये अनुमाना ।",
        "सुरवर मुनिजन योगे समाधी न ये ध्यान ।। १ ।। "
      ],
      "transliteratedLines": [
        "Trigunatmaka Traimurti Datta Ha Jana ।",
        "Triguni Avatara Trailokya Rana ।",
        "Neti Neti Shabda Na Ye Anumana ।",
        "Suravara Munijana Yoge Samadhi Na Ye Dhyana ।। 1 ।। "
      ]
    },
    {
      "id": "v2",
      "lines": [
        "सबाह्य अभ्यंतरी तू एक दत्त ।",
        "अभाग्यासी कैसी नकळे ही मात ।",
        "पराही परतली कैसा हा हेत ।",
        "जन्म मरणाचा पुरलासे अंत ।। २ ।। "
      ],
      "transliteratedLines": [
        "Sabahya Abhyantari Tu Eka Datta ।",
        "Abhagyasi Kaisi Nakaḻe Hi Mata ।",
        "Parahi Paratali Kaisa Ha Heta ।",
        "Janma Maranacha Puralase Anta ।। 2 ।। "
      ]
    },
    {
      "id": "v3",
      "lines": [
        "दत्त येऊनीया उभा ठाकला ।",
        "सद्भावे साष्टांगे प्रणिपात केला ।",
        "प्रसन्न होऊनीया आशीर्वाद दिधला ।",
        "जन्मा मरणाचा फेरा वाचविला ।। ३ ।। "
      ],
      "transliteratedLines": [
        "Datta Yeuniya Ubha Thakala ।",
        "Sadbhave Sashtange Pranipata Kela ।",
        "Prasanna Houniya Ashirvada Didhala ।",
        "Janma Maranacha Phera Vachavila ।। 3 ।। "
      ]
    },
    {
      "id": "v4",
      "lines": [
        "दत्त दत्त ऐसे लागले ध्यान ।",
        "हरपले मन झाले उन्मन ।",
        "मी तू पणाची झाली बोळवण ।",
        "एका जनार्दनी श्री दत्त ध्यान ।। ४ ।। "
      ],
      "transliteratedLines": [
        "Datta Datta Aise Lagale Dhyana ।",
        "Harapale Mana Jhale Unmana ।",
        "Mi Tu Panachi Jhali Boḻavana ।",
        "Eka Janardani Shri Datta Dhyana ।। 4 ।। "
      ]
    }
  ],
  "transliteration": "Shree Datta Aarti (Trigunatmaka Traimurti / Dattatreya)"
