  "verses": [
    {
      "id": "v1",
      "lines": [
        "लवथवती विक्राळा ब्रह्मांडी माळा ।",
        "विर्षे कंठ काळा त्रिनेत्री ज्वाळा ।",
        "लावण्य सुंदर मस्तकी बाळा ।",
        "तेथुनिया जळ निर्मळ वाहे झुळझुळा ॥ १ ॥"
      ],
      "transliteratedLines": [
        "Lavathavati Vikraḻa Brahmandi Maḻa ।",
        "Virshe Kantha Kaḻa Trinetri Jvaḻa ।",
        "Lavanya Sundara Mastaki Baḻa ।",
        "Tethuniya Jaḻa Nirmaḻa Vahe Jhuḻajhuḻa ॥ 1 ॥"
      ]
    },
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय देव जय देव जय श्रीशंकरा ।",
        "आरती ओवाळू तुज कर्पुरगौरा ॥ जय देव ॥"
      ],
      "transliteratedLines": [
        "Jaya Deva Jaya Deva Jaya Shrishankara ।",
        "Arati Ovaḻu Tuja Karpuragaura ॥ Jaya Deva ॥"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "कर्पुरगौरा भोळा नयनी विशाळा ।",
        "अर्धांगी पार्वती सुमनांच्या माळा ।",
        "विभुतीचे उधळण शितकंठ नीळा ।",
        "ऐसा शंकर शोभे उमावेल्हाळा ॥ २ ॥"
      ],
      "transliteratedLines": [
        "Karpuragaura Bhoḻa Nayani Vishaḻa ।",
        "Ardhangi Parvati Sumananchya Maḻa ।",
        "Vibhutiche Udhaḻana Shitakantha Niḻa ।",
        "Aisa Shankara Shobhe Umavelhaḻa ॥ 2 ॥"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "देवी दैत्य सागरमंथन पै केले ।",
        "त्यामाजी अवचित हलाहल जे उठले ।",
        "ते त्वां असुरपणे प्राशन केले ।",
        "नीळकंठ नाम प्रसिद्ध झाले ॥ ३ ॥"
      ],
      "transliteratedLines": [
        "Devi Daitya Sagaramanthana Pai Kele ।",
        "Tyamaji Avachita Halahala Je Uthale ।",
        "Te Tvan Asurapane Prashana Kele ।",
        "Niḻakantha Nama Prasiddha Jhale ॥ 3 ॥"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "व्याघ्रांबर फणिवरधर सुंदर मदनारी ।",
        "पंचानन मनमोहन मुनिजन सुखकारी ।",
        "शतकोटीचे बीज वाचे उच्चारी ।",
        "रघुकुळटिळक रामदासा अंतरी ॥ ४ ॥"
      ],
      "transliteratedLines": [
        "Vyaghranbara Phanivaradhara Sundara Madanari ।",
        "Panchanana Manamohana Munijana Sukhakari ।",
        "Shatakotiche Bija Vache Uchchari ।",
        "Raghukuḻatiḻaka Ramadasa Antari ॥ 4 ॥"
      ]
    }
  ],
