  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय देव जय देव गजनरवेषा ।",
        "आरती ओवाळू तुजला विश्वेशा ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Jaya Deva Jaya Deva Gajanaravesha ।",
        "Arati Ovaḻu Tujala Vishvesha ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "कपोल झरती मदें शुण्डा बहु साजे ।",
        "शेंदुर जो घवघवीत अद्भुत सुविराजे ।",
        "घागरियांचा घोळ पदीं घुळघुळ वाजे ।",
        "प्रसन्नवदना देवा ध्याना सुख माजे ।। १ ।।"
      ],
      "transliteratedLines": [
        "Kapola Jharati Maden Shunda Bahu Saje ।",
        "Shendura Jo Ghavaghavita Adbhuta Suviraje ।",
        "Ghagariyancha Ghoḻa Padin Ghuḻaghuḻa Vaje ।",
        "Prasannavadana Deva Dhyana Sukha Maje ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "विशेष महिमा तुझा नकळे गणनाथा ।",
        "हरिसी संकट विघ्ने तापत्रयव्यथा ।",
        "अखण्ड आनंदे तू डोलविसी माथा ।",
        "ताण्डवनृत्य करिसी तातक धिम ताथा ।। २ ।।"
      ],
      "transliteratedLines": [
        "Vishesha Mahima Tujha Nakaḻe Gananatha ।",
        "Harisi Sankata Vighne Tapatrayavyatha ।",
        "Akhanda Anande Tu Dolavisi Matha ।",
        "Tandavanrutya Karisi Tataka Dhima Tatha ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "विद्या धनसंपदा कनकाच्या राशी ।",
        "नारी सुत मंदिरे सर्वहि तू देशी ।",
        "निर्वाणी पावशी वेगीं भक्तांसी ।",
        "गोसावीनंदन गातो कवितांशी ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Vidya Dhanasanpada Kanakachya Rashi ।",
        "Nari Suta Mandire Sarvahi Tu Deshi ।",
        "Nirvani Pavashi Vegin Bhaktansi ।",
        "Gosavinandana Gato Kavitanshi ।। 3 ।।"
      ]
    }
  ],
  "transliteration": "Shree Ganesh Aarti 4 (Kapol Jharati)"
