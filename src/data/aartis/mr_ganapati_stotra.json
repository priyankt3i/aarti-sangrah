  "verses": [
    {
      "id": "v1",
      "lines": [
        "प्रणम्य शिरसा देवं गौरीपुत्रं विनायकम् ।",
        "भक्तावासं स्मरेन्नित्यमायुःकामार्थसिद्धये ॥ १ ॥"
      ],
      "transliteratedLines": [
        "Pranamya Shirasa Devan Gauriputran Vinayakam ।",
        "Bhaktavasan Smarennityamayuhkamarthasiddhaye ॥ 1 ॥"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "प्रथमं वक्रतुण्डं च एकदन्तं द्वितीयकम् ।",
        "तृतीयं कृष्णपिङ्गाक्षं गजवक्त्रं चतुर्थकम् ॥ २ ॥"
      ],
      "transliteratedLines": [
        "Prathaman Vakratundan Cha Ekadantan Dvitiyakam ।",
        "Trutiyan Krushnapinggakshan Gajavaktran Chaturthakam ॥ 2 ॥"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "लम्बोदरं पञ्चमं च षष्ठं विकटमेव च ।",
        "सप्तमं विघ्नराजं च धूम्रवर्णं तथाष्टकम् ॥ ३ ॥"
      ],
      "transliteratedLines": [
        "Lambodaran Panychaman Cha Shashthan Vikatameva Cha ।",
        "Saptaman Vighnarajan Cha Dhumravarnan Tathashtakam ॥ 3 ॥"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "नवमं भालचन्द्रं च दशमं तु विनायकम् ।",
        "एकादशं गणपतिं द्वादशं तु गजाननम् ॥ ४ ॥"
      ],
      "transliteratedLines": [
        "Navaman Bhalachandran Cha Dashaman Tu Vinayakam ।",
        "Ekadashan Ganapatin Dvadashan Tu Gajananam ॥ 4 ॥"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "द्वादशैतानि नामानि त्रिसन्ध्यं यः पठेन्नरः ।",
        "न च विघ्नभयं तस्य सर्वसिद्धिकरं परम् ॥ ५ ॥"
      ],
      "transliteratedLines": [
        "Dvadashaitani Namani Trisandhyan Yah Pathennarah ।",
        "Na Cha Vighnabhayan Tasya Sarvasiddhikaran Param ॥ 5 ॥"
      ]
    }
  ],
  "transliteration": "Sankat Nashan Ganesh Stotram (Pranamya Shirasa Devam)"
}
