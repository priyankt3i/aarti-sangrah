        "जय देवा कृष्णनाथा । राईरखुमाई कांता ।",
        "आरती ओवाळीन । तुम्हा देवकीसुता ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Jaya Deva Krushnanatha । Rairakhumai Kanta ।",
        "Arati Ovaḻina । Tumha Devakisuta ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "अवतार गोकुळी हो । जन तारावयासी ।",
        "लावण्यरुपडे हो । तेजःपुंजाळ राशी ।",
        "उगवले कोटिबिंब । रवि लोपला शशी ।",
        "उत्साह सुरवरां । महाथोर मानसी ।। १ ।।"
      ],
      "transliteratedLines": [
        "Avatara Gokuḻi Ho । Jana Taravayasi ।",
        "Lavanyarupade Ho । Tejahpunjaḻa Rashi ।",
        "Ugavale Kotibinba । Ravi Lopala Shashi ।",
        "Utsaha Suravaran । Mahathora Manasi ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "कौतुक पहावया । भाव ब्रह्मायाने केली ।",
        "वत्सेंही चोरूनिया । सत्यलोकासी नेलीं ।",
        "गोपाल गाईवत्सें । दोन्ही ठाई रक्षिली ।",
        "सुखाचा प्रेमसिंधू । अनाथांची माऊली ।। २ ।।"
      ],
      "transliteratedLines": [
        "Kautuka Pahavaya । Bhava Brahmayane Keli ।",
        "Vatsenhi Choruniya । Satyalokasi Nelin ।",
        "Gopala Gaivatsen । Donhi Thai Rakshili ।",
        "Sukhacha Premasindhu । Anathanchi Mauli ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "चोरितां गोधनें हो । इन्द्र कोपला भारी ।",
        "मेघ कडाडिला । शिला वर्षल्या धारी ।",
        "रक्षिले गोकुळ हो । नखीं धरिला गिरी ।",
        "निर्भय लोकपाळ । अवतरला हरी ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Choritan Godhanen Ho । Indra Kopala Bhari ।",
        "Megha Kadadila । Shila Varshalya Dhari ।",
        "Rakshile Gokuḻa Ho । Nakhin Dharila Giri ।",
        "Nirbhaya Lokapaḻa । Avatarala Hari ।। 3 ।।"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "वसुदेव देवकीचे । बंद फोडिली शाळ ।",
        "होऊनिया विश्वजनिता । तया पोटींचा बाल ।",
        "दैत्य हे त्रासियेले । समूळ कंसासी काळ ।",
        "राज्य हें उग्रसेना । केला मथुरापाळ ।। ४ ।।"
      ],
      "transliteratedLines": [
        "Vasudeva Devakiche । Banda Phodili Shaḻa ।",
        "Houniya Vishvajanita । Taya Potincha Bala ।",
        "Daitya He Trasiyele । Samuḻa Kansasi Kaḻa ।",
        "Rajya Hen Ugrasena । Kela Mathurapaḻa ।। 4 ।।"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "तारिले भक्तजन । दैत्य सर्व निर्दाळून ।",
        "पांडवा साहाकारी । अडेलिया निर्वाणी ।",
        "गुण मी काय वर्णू । मति केवढी वानूं ।",
        "विनवितो दास तुका । ठाव मागे चरणी ।। ५ ।।"
      ],
      "transliteratedLines": [
        "Tarile Bhaktajana । Daitya Sarva Nirdaḻuna ।",
        "Pandava Sahakari । Adeliya Nirvani ।",
        "Guna Mi Kaya Varnu । Mati Kevadhi Vanun ।",
        "Vinavito Dasa Tuka । Thava Mage Charani ।। 5 ।।"
