    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय देवी जय देवी जय तुळजाभवानी ।",
        "आरती ओवाळूं तुज भवानी ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Jaya Devi Jaya Devi Jaya Tuḻajabhavani ।",
        "Arati Ovaḻun Tuja Bhavani ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "तुळजापुरीं वससी भक्तांच्या काजा ।",
        "कौतुके ओवाळिती तुज ग सुरराजा ।। १ ।।"
      ],
      "transliteratedLines": [
        "Tuḻajapurin Vasasi Bhaktanchya Kaja ।",
        "Kautuke Ovaḻiti Tuja Ga Suraraja ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "महिषासुरमर्दिनी दुर्गे दुर्घटतारिणी ।",
        "दैत्यांसि संहारीं त्रिशूळ धारिणी ।। २ ।।"
      ],
      "transliteratedLines": [
        "Mahishasuramardini Durge Durghatatarini ।",
        "Daityansi Sanharin Trishuḻa Dharini ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "रामदास वंदितो चरणकमळासी ।",
        "सदा सर्वदा रक्षीं आपुल्या दासांसी ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Ramadasa Vandito Charanakamaḻasi ।",
        "Sada Sarvada Rakshin Apulya Dasansi ।। 3 ।।"
      ]
    }
  ],
  "transliteration": "Shree Tuljabhavani Aarti (Jay Devi Jay Tuljabhavani)"
