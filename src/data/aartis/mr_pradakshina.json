  "verses": [
    {
      "id": "v1",
      "lines": [
        "यानि कानि च पापानि जन्मान्तरकृतानि च ।",
        "तानि तानि विनश्यन्ति प्रदक्षिणपदे पदे ।।"
      ],
      "transliteratedLines": [
        "Yani Kani Cha Papani Janmantarakrutani Cha ।",
        "Tani Tani Vinashyanti Pradakshinapade Pade ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "पापोऽहं पापकर्माहं पापात्मा पापसंभवः ।",
        "त्राहि मां कृपया देव शरणागतवत्सल ।।"
      ],
      "transliteratedLines": [
        "Papo'han Papakarmahan Papatma Papasanbhavah ।",
        "Trahi Man Krupaya Deva Sharanagatavatsala ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "अन्यथा शरणं नास्ति त्वमेव शरणं मम ।",
        "तस्मात्कारुण्यभावेन रक्ष माम् परमेश्वर ।।"
      ],
      "transliteratedLines": [
        "Anyatha Sharanan Nasti Tvameva Sharanan Mama ।",
        "Tasmatkarunyabhavena Raksha Mam Parameshvara ।।"
      ]
    }
  ],
  "transliteration": "Pradakshina Mantra (Yani Kani Cha Papani)"
