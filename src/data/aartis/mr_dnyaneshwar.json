      "isChorus": true,
      "lines": [
        "आरती ज्ञानराजा महाकैवल्य तेजा ।",
        "सेविती साधुसन्त मनू वेधला माझा ।। आरती ज्ञानराजा ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "लोपले ज्ञान जगीरु हित नेणती कोणीरु ।",
        "अवतार पांडुरंगरु नाम ठेवीले ज्ञानी ।। १ ।। "
      ]
    },
    {
      "id": "v2",
      "lines": [
        "कनकाचे ताट करीरु उभ्या गोपिका नारीरु ।",
        "नारद तुम्बरहुरु साम गायन करी ।। २ ।। "
      ]
    },
    {
      "id": "v3",
      "lines": [
        "प्रकट गुह्य बोलेरु विश्व ब्रह्माची केलेरु ।",
        "रामा जनार्दनीरु पायी टकची ठेले ।। ३ ।। "
      ]
    }
  ]
