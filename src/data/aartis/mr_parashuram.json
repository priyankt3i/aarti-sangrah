      "lines": [
        "जय देव जय देव जय परशुरामा ।",
        "जमदग्निसुता वीरा रेणुकासुत सुखधामा ।। धृ ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "सहस्रार्जुनाचा संहार । केला परशु हातीं ।",
        "निक्षत्रीय केली पृथ्वी । ब्राह्मणां दान दिधली ख्याती ।। १ ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "कोकण भूमी निर्मिली । बाण मारिला सिंधूवरी ।",
        "चिरंजीव महामुनी । वंदितो महेन्द्रगिरी ।। २ ।।"
      ]
    }
  ]
