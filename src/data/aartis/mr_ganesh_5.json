  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय देव जय देव जय वक्रतुंडा ।",
        "सिंदुरमंडित विशाळ सरळ भुजदंडा ।। जय ।। धृ ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "प्रसन्नभाळा विमला करि घेऊनि कमळा ।",
        "उंदिरवाहन दोंदिल नाचसि बहुलीला ।",
        "रुणझुण करिती घागरिया घोळा ।",
        "सतार सुस्वर गायन शोभित अवलीला ।। १ ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "सारीगमपधनी सप्तस्वरभेदा ।",
        "धिमिकिट धिमिकिट मृदंग वाजति गतिछंदा ।",
        "तातक् तातक् थैय्या करिसी आनंदा ।",
        "ब्रह्मादिक अवलोकिती तव पदारविंदा ।। २ ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "अभयवरदा सुखदा राजिवदलनयना ।",
        "परशांकुशलड्डूधर शोभित शुभवदना ।",
        "ऊर्ध्वदोंदिल उंदिर कार्तिकेस्वर रचना ।",
        "मुक्तेश्वर चरणांबुजिं अलिपरि करी भ्रमणा ।। ३ ।।"
      ]
    }
  ],
  "transliteration": "Shree Ganesh Aarti 5 (Jay Dev Jay Dev Vakratunda)"
