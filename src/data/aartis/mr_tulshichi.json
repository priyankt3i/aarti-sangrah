  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय देवी जय देवी जय तुळसी ।",
        "निजपत्राहुनि लघुतर त्रिभुवन हे तुळिसी ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Jaya Devi Jaya Devi Jaya Tuḻasi ।",
        "Nijapatrahuni Laghutara Tribhuvana He Tuḻisi ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "ब्रह्मा केवळ मुळीं मध्यें तो शौरी ।",
        "अग्रीं शंकर तीर्थें शाखा परिवारीं ।।",
        "सेवा करिती भावें सकळहि नरनारी ।",
        "दर्शनमात्रें पापे हरती निर्धारीं ।। १ ।।"
      ],
      "transliteratedLines": [
        "Brahma Kevaḻa Muḻin Madhyen To Shauri ।",
        "Agrin Shankara Tirthen Shakha Parivarin ।।",
        "Seva Kariti Bhaven Sakaḻahi Naranari ।",
        "Darshanamatren Pape Harati Nirdharin ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "शीतळ छाया भूळव्यापक तूं कैसी ।",
        "मंजिरीची बहु आवड कमळारमणासी ।।",
        "तव दलविरहित विष्णू राहे उपवासी ।",
        "विशेष महिमा तुझा शुभ कार्तिकमासीं ।। २ ।।"
      ],
      "transliteratedLines": [
        "Shitaḻa Chhaya Bhuḻavyapaka Tun Kaisi ।",
        "Manjirichi Bahu Avada Kamaḻaramanasi ।।",
        "Tava Dalavirahita Vishnu Rahe Upavasi ।",
        "Vishesha Mahima Tujha Shubha Kartikamasin ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "अच्युत माधव केशव पीतांबरधारी ।",
        "तुझिया पूजनकाळीं जो हें उच्चारी ।।",
        "त्यासी देसी संतति संपति सुखकारी ।",
        "गोसावीसुत विनवी मजला तूं तारी ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Achyuta Madhava Keshava Pitanbaradhari ।",
        "Tujhiya Pujanakaḻin Jo Hen Uchchari ।।",
        "Tyasi Desi Santati Sanpati Sukhakari ।",
        "Gosavisuta Vinavi Majala Tun Tari ।। 3 ।।"
      ]
    }
  ],
  "transliteration": "Tulshichi Aarti (Tulsi Aarti / Jay Devi Jay Tulashi)"
