    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय देव जय देव जय ज्योतिर्लिंगा ।",
        "वाडीच्या जोतिबा पावे मज सवंगा ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Jaya Deva Jaya Deva Jaya Jyotirlinga ।",
        "Vadichya Jotiba Pave Maja Savanga ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "कोल्हापूर प्रांतीं वाडी रत्नागिरी ।",
        "अवतार घेतलासी दख्खनच्या गिरीं ।। १ ।।"
      ],
      "transliteratedLines": [
        "Kolhapura Prantin Vadi Ratnagiri ।",
        "Avatara Ghetalasi Dakhkhanachya Girin ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "गुलाल खोबऱ्याची उधळण करिती ।",
        "घोडा पाचुचा गळां रुळे मोत्यांची माला ।। २ ।।"
      ],
      "transliteratedLines": [
        "Gulala Khobaऱyachi Udhaḻana Kariti ।",
        "Ghoda Pachucha Gaḻan Ruḻe Motyanchi Mala ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "भक्तां संकटीं धावूनी पावसी ।",
        "किमया दाखविसी निज दासासी ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Bhaktan Sankatin Dhavuni Pavasi ।",
        "Kimaya Dakhavisi Nija Dasasi ।। 3 ।।"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "विष्णूदास नामा जोतिबासी ध्याये ।",
        "सदा सर्वदा वंदी तव पाये ।। ४ ।।"
      ],
      "transliteratedLines": [
        "Vishnudasa Nama Jotibasi Dhyaye ।",
        "Sada Sarvada Vandi Tava Paye ।। 4 ।।"
      ]
    }
  ],
  "transliteration": "Shree Jyotiba Aarti (Wadichya Jyotibachi Aarti / Kolhapur)"
