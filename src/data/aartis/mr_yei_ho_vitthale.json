      ],
      "transliteratedLines": [
        "Vithobache Rajya Amha Nitya Dipavaḻi",
        "Vishnudasa Nama Jive Bhave Ovaḻi ॥ 3 ॥"
      ]
    },
    {
      "id": "v4",
      "lines": [
