      "transliteratedLines": [
        "Yei Ho Viththale Majhe Mauli Ye",
        "Nidhaḻavari Kara Thevuni Vata Mi Pahe ॥ Dhru ॥"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "आलिया गेलिया हाती धाडी निरोप",
        "पंढरपुरी आहे माझा मायबाप ॥ १ ॥"
      ],
      "transliteratedLines": [
        "Aliya Geliya Hati Dhadi Niropa",
        "Pandharapuri Ahe Majha Mayabapa ॥ 1 ॥"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "पिवळा पितांबर कैसा गगनी झळकला",
        "गरुडावरि बैसोनि माझा कैवारी आला ॥ २ ॥"
      ],
      "transliteratedLines": [
        "Pivaḻa Pitanbara Kaisa Gagani Jhaḻakala",
        "Garudavari Baisoni Majha Kaivari Ala ॥ 2 ॥"
      ]
    },
    {
      "id": "v3",
      "lines": [
