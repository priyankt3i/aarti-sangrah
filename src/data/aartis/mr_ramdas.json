  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय देव जय देव श्री रामदासा ।",
        "भक्तकामकल्पद्रुम पुरवीसी आशा ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Jaya Deva Jaya Deva Shri Ramadasa ।",
        "Bhaktakamakalpadruma Puravisi Asha ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "जांब ग्रामीं जन्मलासी सूर्याचे वंशी ।",
        "कौसल्यानंदना स्मरले मानसी ।",
        "बालपणी विरक्त होऊनियां कैसी ।",
        "तपश्चर्या केली पंचवटीपाशी ।। १ ।।"
      ],
      "transliteratedLines": [
        "Janba Gramin Janmalasi Suryache Vanshi ।",
        "Kausalyanandana Smarale Manasi ।",
        "Balapani Virakta Houniyan Kaisi ।",
        "Tapashcharya Keli Panchavatipashi ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "चौदा वर्षे तीर्थे फिरलासी भूमी ।",
        "अनेक भक्तां तारिले कलीयुगामाजी ।",
        "ग्रंथ दासबोध रचिलासी तूचि ।",
        "शिवाजीरायास उपदेशिसी तूचि ।। २ ।।"
      ],
      "transliteratedLines": [
        "Chauda Varshe Tirthe Phiralasi Bhumi ।",
        "Aneka Bhaktan Tarile Kaliyugamaji ।",
        "Grantha Dasabodha Rachilasi Tuchi ।",
        "Shivajirayasa Upadeshisi Tuchi ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "सज्जनगडावर वास्तव्य केले ।",
        "असंख्य भक्तांनागी तारूनिया नेले ।",
        "कल्याण स्वामींचे प्रेम फार भुकेले ।",
        "रामदासांचे चरणीं मस्तक हे ठेविले ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Sajjanagadavara Vastavya Kele ।",
        "Asankhya Bhaktannagi Taruniya Nele ।",
        "Kalyana Svaminche Prema Phara Bhukele ।",
        "Ramadasanche Charanin Mastaka He Thevile ।। 3 ।।"
      ]
    }
  ],
  "transliteration": "Shree Ramdas Aarti (Jay Dev Shri Ramdasa / Samarth Ramdas)"
