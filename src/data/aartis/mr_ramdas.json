  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय देव जय देव श्री रामदासा ।",
        "भक्तकामकल्पद्रुम पुरवीसी आशा ।। धृ ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "जांब ग्रामीं जन्मलासी सूर्याचे वंशी ।",
        "कौसल्यानंदना स्मरले मानसी ।",
        "बालपणी विरक्त होऊनियां कैसी ।",
        "तपश्चर्या केली पंचवटीपाशी ।। १ ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "चौदा वर्षे तीर्थे फिरलासी भूमी ।",
        "अनेक भक्तां तारिले कलीयुगामाजी ।",
        "ग्रंथ दासबोध रचिलासी तूचि ।",
        "शिवाजीरायास उपदेशिसी तूचि ।। २ ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "सज्जनगडावर वास्तव्य केले ।",
        "असंख्य भक्तांनागी तारूनिया नेले ।",
        "कल्याण स्वामींचे प्रेम फार भुकेले ।",
        "रामदासांचे चरणीं मस्तक हे ठेविले ।। ३ ।।"
      ]
    }
  ]
}
