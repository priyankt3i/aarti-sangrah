        "आरती रामराया । आरती रामराया ।",
        "दशरथनंदना तव चरणी लागू पाया ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Arati Ramaraya । Arati Ramaraya ।",
        "Dasharathanandana Tava Charani Lagu Paya ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "कौसल्येचा बाळ । रूप साजिरा वेळ ।",
        "लक्ष्मण भरत शत्रुघ्न । खेळती एका वेळ ।। १ ।।"
      ],
      "transliteratedLines": [
        "Kausalyecha Baḻa । Rupa Sajira Veḻa ।",
        "Lakshmana Bharata Shatrughna । Kheḻati Eka Veḻa ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "विश्वामित्रासंगे । केले ताटिकावध ।",
        "अहिल्या उद्धरिली । लागता पद ।। २ ।।"
      ],
      "transliteratedLines": [
        "Vishvamitrasange । Kele Tatikavadha ।",
        "Ahilya Uddharili । Lagata Pada ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "सीता स्वयंवरी । शिवधनुष्य मोडिले ।",
        "जनकनंदिनीसी । लग्न ते लाविले ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Sita Svayanvari । Shivadhanushya Modile ।",
        "Janakanandinisi । Lagna Te Lavile ।। 3 ।।"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "एका जनार्दनी । राम प्रभूची कीर्ती ।",
        "वानिता न पुरे । शेष शिवाची स्तुती ।। ४ ।।"
      ],
      "transliteratedLines": [
        "Eka Janardani । Rama Prabhuchi Kirti ।",
        "Vanita Na Pure । Shesha Shivachi Stuti ।। 4 ।।"
