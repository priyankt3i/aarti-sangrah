  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय अम्बे गौरी मैया जय श्यामागौरी ।",
        "तुमको निशिदिन ध्यावत हरि ब्रह्मा शिव री ॥",
        "जय अम्बे० ॥"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "माँग सिंदूर विराजत टीको मृगमदको ।",
        "उज्ज्वलसे दोउ नैना, चंद्रवदन नीको ॥"
      ]
    },
    {
      "id": "c2",
      "isChorus": true,
      "lines": [
        "जय अम्बे० ॥"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "कनक समान कलेवर रक्ताम्बर राजै ।",
        "रक्त-पुष्प गल माला, कण्ठनपर साजै ॥"
      ]
    },
    {
      "id": "c3",
      "isChorus": true,
      "lines": [
        "जय अम्बे० ॥"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "केहरि वाहन राजत, खड्ग खपर धारी ।",
        "सुर-नर-मुनि-जन सेवत, तिनके दुखहारी ॥"
      ]
    },
    {
      "id": "c4",
      "isChorus": true,
      "lines": [
        "जय अम्बे० ॥"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "कानन कुण्डल शोभित, नासाग्रे मोती ।",
        "कोटिक चंद्र दिवाकर सम राजत ज्योती ॥"
      ]
    },
    {
      "id": "c5",
      "isChorus": true,
      "lines": [
        "जय अम्बे० ॥"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "शुम्भ निशुम्भ विदारे, महिषासुर-घाती ।",
        "धूम्रविलोचन नैना निशिदिन मदमाती ॥"
      ]
    },
    {
      "id": "c6",
      "isChorus": true,
      "lines": [
        "जय अम्बे० ॥"
      ]
    },
    {
      "id": "v6",
      "lines": [
        "चण्ड मुण्ड संहारे, शोणितबीज हरे ।",
        "मधु कैटभ दोउ मारे, सुर भयहीन करे ॥"
      ]
    },
    {
      "id": "c7",
      "isChorus": true,
      "lines": [
        "जय अम्बे० ॥"
      ]
    },
    {
      "id": "v7",
      "lines": [
        "ब्रह्माणी, रुद्राणी तुम कमलरानी ।",
        "आगम-निगम-बखानी, तुम शिव पटरानी ॥"
      ]
    },
    {
      "id": "c8",
      "isChorus": true,
      "lines": [
        "जय अम्बे० ॥"
      ]
    },
    {
      "id": "v8",
      "lines": [
        "चौंसठ योगिनि गावत, नृत्य करत भैरूँ ।",
        "बाजत ताल मृदंगा औ बाजत डमरू ॥"
      ]
    },
    {
      "id": "c9",
      "isChorus": true,
      "lines": [
        "जय अम्बे० ॥"
      ]
    },
    {
      "id": "v9",
      "lines": [
        "तुम ही जगकी माता, तुम ही हो भरता ।",
        "भक्तनकी दुख हरता सुख सम्पति करता ॥"
      ]
    },
    {
      "id": "c10",
      "isChorus": true,
      "lines": [
        "जय अम्बे० ॥"
      ]
    },
    {
      "id": "v10",
      "lines": [
        "भुजा चार अति शोभित, वर-मुद्रा धारी ।",
        "मनवाञ्छित फल पावत, सेवत नर-नारी ॥"
      ]
    },
    {
      "id": "c11",
      "isChorus": true,
      "lines": [
        "जय अम्बे० ॥"
      ]
    },
    {
      "id": "v11",
      "lines": [
        "कंचन थाल विराजत अगर कपूर बाती ।",
        "श्री मालकेतुमें राजत कोटिरतन ज्योती ॥"
      ]
    },
    {
      "id": "c12",
      "isChorus": true,
      "lines": [
        "जय अम्बे० ॥"
      ]
    },
    {
      "id": "v12",
      "lines": [
        "श्री अम्बेजीकी आरति जो कोइ नर गावै ।",
        "कहत शिवानँद स्वामी, सुख सम्पति पावै ॥"
      ]
    },
    {
      "id": "c13",
      "isChorus": true,
      "lines": [
        "जय अम्बे० ॥"
      ]
    }
  ],
  "transliteration": "Ambe Gauri Aarti (Jai Ambe Gauri / Durga Aarti)"
}
