    },
    {
      "id": "v1",
      "lines": [
        "उत्कट साधुनि शिळा सेतु बांधोनी ।",
        "लिंगदेह लंकापुरी विध्वंसूनी ।",
        "कामक्रोधादिक राक्षस मर्दूनी ।",
        "देह अहंभाव रावण निवटूनी ।। १ ।। "
      ],
      "transliteratedLines": [
        "Utkata Sadhuni Shiḻa Setu Bandhoni ।",
        "Lingadeha Lankapuri Vidhvansuni ।",
        "Kamakrodhadika Rakshasa Marduni ।",
        "Deha Ahanbhava Ravana Nivatuni ।। 1 ।। "
      ]
    },
    {
      "id": "v2",
      "lines": [
        "प्रथम सीताशुद्धी हनुमंत गेला ।",
        "लंका दहन करुनी अखया मारिला ।",
        "मारिला जंबुमाळी भुवनी त्राहाटीला ।",
        "आनंदाची गुढी घेऊनिया आला ।। २ ।। "
      ],
      "transliteratedLines": [
        "Prathama Sitashuddhi Hanumanta Gela ।",
        "Lanka Dahana Karuni Akhaya Marila ।",
        "Marila Janbumaḻi Bhuvani Trahatila ।",
        "Anandachi Gudhi Gheuniya Ala ।। 2 ।। "
      ]
    },
    {
      "id": "v3",
      "lines": [
        "निजबळें निजशक्ती सोडविली सीता ।",
        "म्हणुनि येणें झालें अयोध्ये रघुनाथा ।",
        "आनंदे ओसंडे वैराग्य भरता ।",
        "आरती घेऊनि आली कौसल्या माता ।। ३ ।। "
      ],
      "transliteratedLines": [
        "Nijabaḻen Nijashakti Sodavili Sita ।",
        "Mhanuni Yenen Jhalen Ayodhye Raghunatha ।",
        "Anande Osande Vairagya Bharata ।",
        "Arati Gheuni Ali Kausalya Mata ।। 3 ।। "
      ]
    },
    {
      "id": "v4",
      "lines": [
        "अनाहतध्वनी गर्जती अपार ।",
        "अठरा पद्मं वानर करिती भुभुःकार ।",
        "अयोध्येसी आले दशरथकुमार ।",
        "नगरीं होत आहे आनंद थोर ।। ४ ।। "
