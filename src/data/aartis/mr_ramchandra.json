  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय देव जय देव निजबोधा रामा ।",
        "परमार्थें आरती सद्भावें आरती परिपूर्णकामा ।। धृ ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "उत्कट साधुनि शिळा सेतु बांधोनी ।",
        "लिंगदेह लंकापुरी विध्वंसूनी ।",
        "कामक्रोधादिक राक्षस मर्दूनी ।",
        "देह अहंभाव रावण निवटूनी ।। १ ।। "
      ]
    },
    {
      "id": "v2",
      "lines": [
        "प्रथम सीताशुद्धी हनुमंत गेला ।",
        "लंका दहन करुनी अखया मारिला ।",
        "मारिला जंबुमाळी भुवनी त्राहाटीला ।",
        "आनंदाची गुढी घेऊनिया आला ।। २ ।। "
      ]
    },
    {
      "id": "v3",
      "lines": [
        "निजबळें निजशक्ती सोडविली सीता ।",
        "म्हणुनि येणें झालें अयोध्ये रघुनाथा ।",
        "आनंदे ओसंडे वैराग्य भरता ।",
        "आरती घेऊनि आली कौसल्या माता ।। ३ ।। "
      ]
    },
    {
      "id": "v4",
      "lines": [
        "अनाहतध्वनी गर्जती अपार ।",
        "अठरा पद्मं वानर करिती भुभुःकार ।",
        "अयोध्येसी आले दशरथकुमार ।",
        "नगरीं होत आहे आनंद थोर ।। ४ ।। "
      ]
    },
    {
      "id": "v5",
      "lines": [
        "सहज सिंहासनीं राजा रघुवीर ।",
        "सोहंभावें तया पूजा उपचार ।",
        "सहजांची आरती वाद्यांचा गजर ।",
        "माधवदासा स्वामी आठव ना विसर ।। ५ ।। "
      ]
    }
  ],
  "transliteration": "Shree Ramchandranchi Aarti (Utkat Sadhuni / Shri Ram Aarti)"
}
