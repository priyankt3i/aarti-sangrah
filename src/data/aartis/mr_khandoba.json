  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय देव जय देव जय शिव मल्हारी ।",
        "वारीं दुर्जन असुरां भवदुस्तर तारी ।। जय देव ।।"
      ],
      "transliteratedLines": [
        "Jaya Deva Jaya Deva Jaya Shiva Malhari ।",
        "Varin Durjana Asuran Bhavadustara Tari ।। Jaya Deva ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "पंचानन हयवाहन सुरभूषितनीळा ।",
        "खंडामंडित दंडित दानव अवलीळा ।",
        "मणिमल्लां मर्दुनियां जों धूसुर पिवळा ।",
        "हिरे कंकण बासिंगे सुमनांच्या माळा ।। १ ।। "
      ],
      "transliteratedLines": [
        "Panchanana Hayavahana Surabhushitaniḻa ।",
        "Khandamandita Dandita Danava Avaliḻa ।",
        "Manimallan Marduniyan Jon Dhusura Pivaḻa ।",
        "Hire Kankana Basinge Sumananchya Maḻa ।। 1 ।। "
      ]
    },
    {
      "id": "v2",
      "lines": [
        "सुरवर संवर वर दे मजलागी देवा ।",
        "नाना नामे गाईन ही तुमची सेवा ।",
        "अघटित गुण गावया वाटतसे हेवा ।",
        "फणिवर शिणला किती नर पामर केवा ।। २ ।। "
      ],
      "transliteratedLines": [
        "Suravara Sanvara Vara De Majalagi Deva ।",
        "Nana Name Gaina Hi Tumachi Seva ।",
        "Aghatita Guna Gavaya Vatatase Heva ।",
        "Phanivara Shinala Kiti Nara Pamara Keva ।। 2 ।। "
      ]
    },
    {
      "id": "v3",
      "lines": [
        "रघुवीरस्मरणी शंकर हृदयीं निवाला ।",
        "तो हा मल्लंतक अवतार झाला ।",
        "यालागीं आवडे भाव वर्णिला ।",
        "रामी रामदासा जिवलग भेडला ।। ३ ।। "
      ],
      "transliteratedLines": [
        "Raghuvirasmarani Shankara Hrudayin Nivala ।",
        "To Ha Mallantaka Avatara Jhala ।",
        "Yalagin Avade Bhava Varnila ।",
        "Rami Ramadasa Jivalaga Bhedala ।। 3 ।। "
      ]
    }
  ],
  "transliteration": "Shree Khandobachi Aarti (Jay Shiv Malhari / Jejuri Khandoba)"
