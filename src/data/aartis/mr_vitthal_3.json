  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "ओवाळूं ग माये विठ्ठल सबाह्य साजिरा ।",
        "राईरखुमाबाई सत्यभामेच्या वरा ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Ovaḻun Ga Maye Viththala Sabahya Sajira ।",
        "Rairakhumabai Satyabhamechya Vara ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "कनकाचे पर्यंकीं उजळोनी आरती ।",
        "रत्नदीपशोभा कैशा प्रकाशल्या ज्योती ।। १ ।।"
      ],
      "transliteratedLines": [
        "Kanakache Paryankin Ujaḻoni Arati ।",
        "Ratnadipashobha Kaisha Prakashalya Jyoti ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "मंडित चतुर्भुज कानीं शोभत कुंडले ।",
        "श्रीमुखाची शोभा पाहतां तेज फांकले ।। २ ।।"
      ],
      "transliteratedLines": [
        "Mandita Chaturbhuja Kanin Shobhata Kundale ।",
        "Shrimukhachi Shobha Pahatan Teja Phankale ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "वैजयंती माळ गळा शोभे स्यमंत ।",
        "शङ्खचक्रगदापद्म आयुधें शोभत ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Vaijayanti Maḻa Gaḻa Shobhe Syamanta ।",
        "Shangkhachakragadapadma Ayudhen Shobhata ।। 3 ।।"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "सांवळा सुंदर जैसा कर्दळीचा गाभा ।",
        "चरणींचीं नूपुरें वांक्या गाजती नभा ।। ४ ।।"
      ],
      "transliteratedLines": [
        "Sanvaḻa Sundara Jaisa Kardaḻicha Gabha ।",
        "Charaninchin Nupuren Vankya Gajati Nabha ।। 4 ।।"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "ओवाळीता मन माझें ठाकलें ठायी ।",
        "समाधिस्थसमान तुकया लागला पायी ।। ५ ।।"
      ],
      "transliteratedLines": [
        "Ovaḻita Mana Majhen Thakalen Thayi ।",
        "Samadhisthasamana Tukaya Lagala Payi ।। 5 ।।"
      ]
    }
  ],
  "transliteration": "Shree Vitthal Aarti 3 (Owalu Ga Maye)"
