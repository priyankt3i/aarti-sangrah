      "isChorus": true,
      "lines": [
        "ॐ जय शिव ओंकारा, स्वामी जय शिव ओंकारा ।",
        "ब्रह्मा, विष्णु, सदाशिव, अर्द्धांगी धारा ॥",
        "ॐ जय शिव ओंकारा ॥"
      ],
      "transliteratedLines": [
        "On Jaya Shiva Onkara, Svami Jaya Shiva Onkara ।",
        "Brahma, Vishnu, Sadashiva, Arddhangi Dhara ॥",
        "On Jaya Shiva Onkara ॥"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "एकानन चतुरानन पञ्चानन राजे ।",
        "हंसासन गरुड़ासन वृषवाहन साजे ॥",
        "ॐ जय शिव ओंकारा ॥ १ ॥"
      ],
      "transliteratedLines": [
        "Ekanana Chaturanana Panychanana Raje ।",
        "Hansasana Garuड़asana Vrushavahana Saje ॥",
        "On Jaya Shiva Onkara ॥ 1 ॥"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "दो भुज चारु चतुर्भुज दशभुज अति सोहे ।",
        "त्रिगुण रूप निरखते त्रिभुवन जन मोहे ॥",
        "ॐ जय शिव ओंकारा ॥ २ ॥"
      ],
      "transliteratedLines": [
        "Do Bhuja Charu Chaturbhuja Dashabhuja Ati Sohe ।",
        "Triguna Rupa Nirakhate Tribhuvana Jana Mohe ॥",
        "On Jaya Shiva Onkara ॥ 2 ॥"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "अक्षमाला वनमाला मुण्डमाला धारी ।",
        "चन्दन मृगमद सोहै भाले शशिधारी ॥",
        "ॐ जय शिव ओंकारा ॥ ३ ॥"
      ],
      "transliteratedLines": [
        "Akshamala Vanamala Mundamala Dhari ।",
        "Chandana Mrugamada Sohai Bhale Shashidhari ॥",
        "On Jaya Shiva Onkara ॥ 3 ॥"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "श्वेताम्बर पीताम्बर बाघम्बर अङ्गे ।",
        "सनकादिक गरुणादिक भूतादिक सङ्गे ॥",
        "ॐ जय शिव ओंकारा ॥ ४ ॥"
      ],
      "transliteratedLines": [
        "Shvetambara Pitambara Baghambara Angge ।",
        "Sanakadika Garunadika Bhutadika Sangge ॥",
        "On Jaya Shiva Onkara ॥ 4 ॥"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "कर के मध्य कमण्डलु चक्र त्रिशूल धर्ता ।",
        "जगकर्ता जगभर्ता जगसंहारकर्ता ॥",
        "ॐ जय शिव ओंकारा ॥ ५ ॥"
      ],
      "transliteratedLines": [
        "Kara Ke Madhya Kamandalu Chakra Trishula Dharta ।",
        "Jagakarta Jagabharta Jagasanharakarta ॥",
        "On Jaya Shiva Onkara ॥ 5 ॥"
      ]
    },
    {
      "id": "v6",
      "lines": [
        "ब्रह्मा विष्णु सदाशिव जानत अविवेका ।",
        "प्रणवाक्षर में शोभित ये तीनों एका ॥",
        "ॐ जय शिव ओंकारा ॥ ६ ॥"
      ],
      "transliteratedLines": [
        "Brahma Vishnu Sadashiva Janata Aviveka ।",
        "Pranavakshara Men Shobhita Ye Tinon Eka ॥",
        "On Jaya Shiva Onkara ॥ 6 ॥"
      ]
    },
    {
      "id": "v7",
      "lines": [
        "त्रिगुणस्वामी जी की आरती जो कोई नर गावे ।",
        "कहत शिवानन्द स्वामी मनवांछित फल पावे ॥",
        "ॐ जय शिव ओंकारा ॥ ७ ॥"
      ],
      "transliteratedLines": [
        "Trigunasvami Ji Ki Arati Jo Koi Nara Gave ।",
        "Kahata Shivananda Svami Manavanchhita Phala Pave ॥",
        "On Jaya Shiva Onkara ॥ 7 ॥"
      ]
    }
  ],
  "transliteration": "Shiv Ji Ki Aarti (Om Jai Shiv Omkara)"
