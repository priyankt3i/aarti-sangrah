      "lines": [
        "आरती निवृत्तिनाथा । ज्ञानगंगोत्रीच्या ताता ।",
        "त्र्यंबकेश्वरवासी स्वामी । चरणी ठेविला माथा ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Arati Nivruttinatha । Jnyanagangotrichya Tata ।",
        "Tryanbakeshvaravasi Svami । Charani Thevila Matha ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "गहिनीनाथांचा अनुग्रह । लाधलासी तुज थोर ।",
        "ज्ञानदेवा उपदेशिला । ब्रह्मविद्येचा विचार ।। १ ।।"
      ],
      "transliteratedLines": [
        "Gahininathancha Anugraha । Ladhalasi Tuja Thora ।",
        "Jnyanadeva Upadeshila । Brahmavidyecha Vichara ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "चारही भावंडे धन्य । वारकरी संप्रदायीं ।",
        "कल्याणाचे मूळ तूंचि । निवृत्तीराया पायीं ।। २ ।।"
      ],
      "transliteratedLines": [
        "Charahi Bhavande Dhanya । Varakari Sanpradayin ।",
        "Kalyanache Muḻa Tunchi । Nivruttiraya Payin ।। 2 ।।"
      ]
