    {
      "id": "v1",
      "lines": [
        "नाना परिमळ दुर्वा शेंदूर शमीपत्रे ।",
        "लाडू मोदक अन्ने परिपूरित पात्रे ॥",
        "ऐसे पूजन केल्या बीजाक्षर मंत्रे ।",
        "अष्टही सिद्धी नवनिधी देसी क्षणमात्रे ॥ १ ॥"
      ]
    },
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय देव जय देव जय मंगलमूर्ती ।",
        "तुझे गुण वर्णाया मज कैची स्फूर्ती ॥ जय देव ॥"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "तुझे ध्यान निरंतर जे कोणी करिती ।",
        "त्यांची सकलही पापे विघ्नेही हरती ॥",
        "वाजी वारण शिबिका सेवक सुत युवती ।",
        "सर्वही पावुनि अंती भवसागर तरती ॥ २ ॥"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "शरणागत सर्वस्वे भजती तव चरणी ।",
        "कीर्ती तयांची राहे जोवरि शशितरणी ॥",
        "त्रैलोक्यी ते विजयी अद्भुत हे करणी ।",
        "गोसावीनंदन रत नामस्मरणी ॥ ३ ॥"
      ]
    }
  ],
  "transliteration": "Nana Parimal Durva (Ganpati Aarti 2)"
