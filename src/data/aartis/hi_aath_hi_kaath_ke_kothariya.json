  "verses": [
    {
      "id": "v1",
      "lines": [
        "आठ ही काठ के कोठरिया हो दीनानाथ,",
        "रूपे छन लागल केवाड़ ।",
        "ताही ऊपर चढ़ि सूतले हो दीनानाथ,",
        "बाँझी केवड़वा धइले ठाढ़ ॥"
      ],
      "transliteratedLines": [
        "Aath Hee Kaath Ke Kothariya Ho Deenanaath,",
        "Roope Chhan Laagal Kevaad ।",
        "Taahi Oopar Chadhi Sootale Ho Deenanaath,",
        "Baanjhi Kevadawa Dhaile Thaadh ॥"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "कवन देई अइली मोरा दुअरा हो दीनानाथ,",
        "कवन फल माँगे आज ? ",
        "हाथ जोड़ि विनती करे व्रतिनिया,",
        "सुन लीं हे दीनानाथ ॥"
      ],
      "transliteratedLines": [
        "Kawan Dayee Aili Mora Duara Ho Deenanaath,",
        "Kawan Phal Maange Aaj ? ",
        "Haath Jodi Vinati Kare Vratiniya,",
        "Sun Leen He Deenanaath ॥"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "अन्हरा के आँख दिहले हो दीनानाथ,",
        "कोढ़िया के दिहले काया ।",
        "हँसत-बोलत घर के भेजल,",
        "महिमा तोहार अपार ॥"
      ],
      "transliteratedLines": [
        "Anhara Ke Aankh Dihale Ho Deenanaath,",
        "Kodhiya Ke Dihale Kaaya ।",
        "Hansat-Bolat Ghar Ke Bhejal,",
        "Mahima Tohaar Apaar ॥"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "निर्धन के धन दिहले हो दीनानाथ,",
        "निपुतर के दिहले लाल ।",
        "जे-जे आइल तोहरे दुअरिया,",
        "सबके कइल निहाल ॥"
      ],
      "transliteratedLines": [
        "Nirdhan Ke Dhan Dihale Ho Deenanaath,",
        "Niputar Ke Dihale Laal ।",
        "Je-Je Aail Tohre Duariya,",
        "Sabke Kail Nihaal ॥"
      ]
    },
    {
