  "verses": [
    {
      "id": "v1",
      "lines": [
        "सुखसदने शशिवदने अंबे मृगनयने ।",
        "गजगमने सुरनमने कोल्हापुरमथने ।",
        "सुरवर वर्षति सुमनें करुनियां नमनें ।",
        "भयहरणे सुखकरणे सुंदरी शिवरमणे ।। १ ।।"
      ],
      "transliteratedLines": [
        "Sukhasadane Shashivadane Anbe Mruganayane ।",
        "Gajagamane Suranamane Kolhapuramathane ।",
        "Suravara Varshati Sumanen Karuniyan Namanen ।",
        "Bhayaharane Sukhakarane Sundari Shivaramane ।। 1 ।।"
      ]
    },
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय देवी जय देवी वो जय अंबे ।",
        "कोल्हापुराधिस्वामिणि तुज वो जगदंबे ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Jaya Devi Jaya Devi Vo Jaya Anbe ।",
        "Kolhapuradhisvamini Tuja Vo Jagadanbe ।। Dhru ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "मृगमदमिश्रित केशर शोभत तें भाळीं ।",
        "कुंचित केश विराजित मुगुटांतून भाळीं ।",
        "रत्नजडित सुंदर अंगी कांचोळी ।",
        "चिद्गगनाचा गाभा अंबा वेल्हाळी ।। जय ।। २ ।।"
      ],
      "transliteratedLines": [
        "Mrugamadamishrita Keshara Shobhata Ten Bhaḻin ।",
        "Kunchita Kesha Virajita Mugutantuna Bhaḻin ।",
        "Ratnajadita Sundara Angi Kanchoḻi ।",
        "Chidgaganacha Gabha Anba Velhaḻi ।। Jaya ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "कंठी विलसत सगुण मुक्ता सुविशेषें ।",
        "पीतांबर सुंदर कसियेला कांसे ।",
        "कटितटि कांची किंकिणि ध्वनि मंजुळ भासे ।",
        "पदकमळ लावण्ये अंबा शोभतसे ।। जय ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Kanthi Vilasata Saguna Mukta Suvisheshen ।",
        "Pitanbara Sundara Kasiyela Kanse ।",
        "Katitati Kanchi Kinkini Dhvani Manjuḻa Bhase ।",
        "Padakamaḻa Lavanye Anba Shobhatase ।। Jaya ।। 3 ।।"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "झळझळझळझळ झळकति तानवडे कर्णी ।",
        "तेजा लोपुनि गेले रविशशि निज करणीं ।",
        "ब्रह्महरिहर सकळिक नेणति तव करणी ।",
        "अद्भुत लीला लिहितां न पुरे ही धरणी ।। जय ।। ४ ।।"
      ],
      "transliteratedLines": [
        "Jhaḻajhaḻajhaḻajhaḻa Jhaḻakati Tanavade Karni ।",
        "Teja Lopuni Gele Ravishashi Nija Karanin ।",
        "Brahmaharihara Sakaḻika Nenati Tava Karani ।",
        "Adbhuta Lila Lihitan Na Pure Hi Dharani ।। Jaya ।। 4 ।।"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "अष्टहि भूजा सुंदर शोभतसे ।",
        "झगझगझगझगझगति लावण्यगाभा ।",
        "म्हरगम्हरगम्हरगम्हरगीत समनांची शोभा ।।",
        "त्र्यंबक मधुकर होऊनि वर्णितसे अंबा ।। ५ ।।"
      ],
      "transliteratedLines": [
        "Ashtahi Bhuja Sundara Shobhatase ।",
        "Jhagajhagajhagajhagajhagati Lavanyagabha ।",
        "Mharagamharagamharagamharagita Samananchi Shobha ।।",
        "Tryanbaka Madhukara Houni Varnitase Anba ।। 5 ।।"
      ]
    }
  ],
  "transliteration": "Shree Amba Aarti (Sukhsadane Shashivadane / Kolhapur Ambabai)"
