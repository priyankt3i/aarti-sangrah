  "verses": [
    {
      "id": "v1",
      "lines": [
        "धूपारती करू चला । माझ्या रामा । माझ्या रामा ।",
        "धूप दीप नैवेद्य । करू चला माझ्या रामा ।।"
      ],
      "transliteratedLines": [
        "Dhuparati Karu Chala । Majhya Rama । Majhya Rama ।",
        "Dhupa Dipa Naivedya । Karu Chala Majhya Rama ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "दशांग धूप सुवासिक । माझ्या रामा ।",
        "प्रगटला सुगंध अधिक । माझ्या रामा ।।"
      ],
      "transliteratedLines": [
        "Dashanga Dhupa Suvasika । Majhya Rama ।",
        "Pragatala Sugandha Adhika । Majhya Rama ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "एका जनार्दनी । माझ्या रामा ।",
        "आनंदे वोवाळूनी । माझ्या रामा ।।"
      ],
      "transliteratedLines": [
        "Eka Janardani । Majhya Rama ।",
        "Anande Vovaḻuni । Majhya Rama ।।"
      ]
    }
  ],
  "transliteration": "Dhoop Aarti (Dhup Aarti)"
}
