  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "आरती श्रीरामायणजी की ।",
        "कीरति कलित ललित सिय-पी की ॥ धृ ॥"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "गावत ब्रह्मादिक मुनि नारद ।",
        "बालमीक बिग्यान बिसारद ॥",
        "सुक सनकादि सेष अरु सारद ।",
        "बरनि पवनसुत कीरति नीकी ॥ १ ॥"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "गावत संतत संभु भवानी ।",
        "अरु घटसंभव मुनि बिग्यानी ॥",
        "ब्यास आदि कबिबर्ज बखानी ।",
        "कागभुसुंडि गरुड़ के ही की ॥ २ ॥"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "चारिउ बेद पुरान उपनिषद ।",
        "छहों सास्त्र सब ग्रंथन को मद ॥",
        "तन सर बस पंचम बेद सुभग नद ।",
        "बिभव जनन हरि चरित रची की ॥ ३ ॥"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "कलिमल हरनि बिषय रस फीकी ।",
        "सुभग सिंगार मुकति जुबती की ॥",
        "दलन रोग भव मूरि अमी की ।",
        "तात मात सब बिधि तुलसी की ॥ ४ ॥"
      ]
    }
  ],
  "transliteration": "Aarti Shree Ramayan Ji Ki (Ramayana Aarti)"
}
