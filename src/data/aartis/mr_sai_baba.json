  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "आरती साईबाबा । सौख्यदातार जीवा ।",
        "चरणरजतळीं । द्यावा दासा विसावा । भक्ता विसावा ।। धृ ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "जाळुनिया अनंग । स्वस्वरूपीं राहे दंग ।",
        "मुमुक्षू जनां दावी । निज डोळां श्रीरंग ।। १ ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "जया मनीं जैसा भाव । तया तैसा अनुभव ।",
        "दाविसी दयाघना । ऐसी तुझी ही माव ।। २ ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "तुमचे नाम ध्याता । हरे संस्कृती व्यथा ।",
        "अगाध तव करणी । मार्ग दाविसी अनाथा ।। ३ ।।"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "कलियुगीं अवतार । सगुण परब्रह्म साचार ।",
        "अवतीर्ण झालासे । स्वामी दत्त दिगंबर ।। ४ ।।"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "आठा दिवसां गुरुवारीं । भक्त करिती वारी ।",
        "प्रभुपद पहावया । भवभय निवारी ।। ५ ।।"
      ]
    },
    {
      "id": "v6",
      "lines": [
        "माझा निजद्रव्य ठेवा । तव चरणरज सेवा ।",
        "मागणें हेंचि आतां । तुम्हा देवाधिदेवा ।। ६ ।।"
      ]
    },
    {
      "id": "v7",
      "lines": [
        "इच्छित दिनचातक । निर्मळ तोय निजसुख ।",
        "पाजावें माधवा या । सांभाळ अपुली भाक ।। ७ ।।"
      ]
    }
  ],
  "transliteration": "Shree Sai Baba Aarti (Aarti Sai Baba / Shirdi Sainath)"
}
