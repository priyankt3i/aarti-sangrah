      "lines": [
        "आरती ज्ञानराजा । महाकैवल्यतेजा ।",
        "सेविती साधुसंत । मनु वेधला माझा ।। धृ ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "लोपले ज्ञान जगीं । हित नेणती कोणी ।",
        "अवतार पांडुरंग । नाम ठेविले ज्ञानी ।। १ ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "कनकाचे ताट करीं । उभ्या गोपिका नारी ।",
        "नारद तुंबरहो । साम गायन करी ।। २ ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "प्रगट गुह्य बोले । विश्व ब्रह्मचि केलें ।",
        "रामा जनार्दनी । पायीं मस्तक ठेविलें ।। ३ ।।"
      ]
    }
  ]
