  "durationMinutes": 3,
  "searchKeywords": ["pasaydan", "pasaydaan", "aata", "vishwatmake", "dnyaneshwar"],
  "source": "Marathi Aarti Sangrah",
  "reviewed": true,
  "updatedAt": "2026-09-16T12:00:00.000Z",
  "verses": [
    {
      "id": "v1",
      "lines": [
        "आतां विश्वात्मकें देवें । येणे वाग्यज्ञें तोषावें ।",
        "तोषोनिं मज द्यावे । पसायदान हें ।। १ ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "जें खळांची व्यंकटी सांडो । तया सत्कर्मी- रती वाढो ।",
        "भूतां परस्परे पडो । मैत्र जीवांचें ।। २ ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "दुितांचे तिमिर जावो । विश्व स्वधर्म सूर्यें पाहो ।",
        "जो जे वांच्छिल तो तें लाहो । प्राणिजात ।। ३ ।।"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "वर्षत सकळ मंगळी । ईश्वरनिष्ठांची मांदियाळी ।",
        "अनवरत भूमंडळी । भेटतु भूतां ।। ४ ।।"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "चलां कल्पतरूंचे आरव । चेतना चिंतामणींचें गाव ।",
        "बोलते जे अर्णव । पीयूषाचे ।। ५ ।।"
      ]
    },
    {
      "id": "v6",
      "lines": [
        "चंद्रमे जे अलांछन । मार्तंड जे तापहीन ।",
        "ते सर्वांही सदा सज्जन । सोयरे होतु ।। ६ ।।"
      ]
    },
    {
      "id": "v7",
      "lines": [
        "किंबहुना सर्व सुखी । पूर्ण होऊनि तिहीं लोकी ।",
        "भजिजो आदिपुरुखी । अखंडित ।। ७ ।।"
      ]
    },
    {
      "id": "v8",
      "lines": [
        "आणि ग्रंथोपजीविये । विशेषीं लोकीं इयें ।",
        "दृष्टादृष्ट विजयें । होआवे जी । ८ ।।"
      ]
    },
    {
      "id": "v9",
      "lines": [
        "येथ म्हणे श्री विश्वेशरावो । हा होईल दानपसावो ।",
        "येणें वरें ज्ञानदेवो । सुखिया जाला ।। ९ ।।"
      ]
    }
  ]
}
