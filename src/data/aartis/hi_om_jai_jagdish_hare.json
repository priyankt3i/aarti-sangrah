  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "ॐ जय जगदीश हरे",
        "स्वामी जय जगदीश हरे",
        "भक्त जनों के संकट, दास जनों के संकट",
        "क्षण में दूर करे",
        "ॐ जय जगदीश हरे"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "जो ध्यावे फल पावे, दुःख बिन से मन का",
        "स्वामी दुख बिन से मन का",
        "सुख सम्पति घर आवे",
        "सुख सम्पति घर आवे",
        "कष्ट मिटे तन का",
        "ॐ जय जगदीश हरे"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "मात पिता तुम मेरे, शरण गहूं किसकी",
        "स्वामी शरण गहूं किसकी",
        "तुम बिन और ना दूजा",
        "तुम बिन और ना दूजा",
        "आस करूँ जिसकी",
        "ॐ जय जगदीश हरे"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "तुम पूरण परमात्मा, तुम अंतरियामी",
        "स्वामी तुम अंतरियामी",
        "पार ब्रह्म परमेश्वर",
        "पार ब्रह्म परमेश्वर",
        "तुम सबके स्वामी",
        "ॐ जय जगदीश हरे"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "तुम करुणा के सागर, तुम पालन करता",
        "स्वामी तुम पालन करता",
        "मैं मूरख खलकामी",
        "मैं सेवक तुम स्वामी",
        "कृपा करो भर्ता",
        "ॐ जय जगदीश हरे"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "तुम हो एक अगोचर, सबके प्राण पति",
        "स्वामी सबके प्राण पति",
        "किस विध मिलु दयामय",
        "किस विध मिलु दयामय",
        "तुम को मैं कुमति",
        "ॐ जय जगदीश हरे"
      ]
    },
    {
      "id": "v6",
      "lines": [
        "दीन बन्धु दुःख हर्ता, ठाकुर तुम मेरे",
        "स्वामी रक्षक तुम मेरे",
        "अपने हाथ उठाओ",
        "अपनी शरण लगाओ",
        "द्वार पड़ा तेरे",
        "ॐ जय जगदीश हरे"
      ]
    },
    {
      "id": "v7",
      "lines": [
        "विषय-विकार मिटाओ, पाप हरो देवा",
        "स्वामी पाप हरो देवा",
        "श्रद्धा भक्ति बढ़ाओ",
        "श्रद्धा भक्ति बढ़ाओ",
        "सन्तन की सेवा",
        "ॐ जय जगदीश हरे"
      ]
    }
  ]
