    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय देव जय देव श्रीसत्यनारायणा ।",
        "आरती ओवाळू पाहू सुंदर वदना ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Jaya Deva Jaya Deva Shrisatyanarayana ।",
        "Arati Ovaḻu Pahu Sundara Vadana ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "कलियुगीं हा अवतार । भक्तां संकटीं तारी ।",
        "नानापरीचे भोग । अर्पू तुज भारी ।। १ ।।"
      ],
      "transliteratedLines": [
        "Kaliyugin Ha Avatara । Bhaktan Sankatin Tari ।",
        "Nanapariche Bhoga । Arpu Tuja Bhari ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "ब्राह्मण रूप घेऊनी । दर्शन दिधले ।",
        "साधू वाण्यासी । रक्षण केले ।। २ ।।"
      ],
      "transliteratedLines": [
        "Brahmana Rupa Gheuni । Darshana Didhale ।",
        "Sadhu Vanyasi । Rakshana Kele ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "लीलावती माता । कलावती कन्या ।",
        "भक्तीभावे करिती । व्रत ते तत्त्वता ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Lilavati Mata । Kalavati Kanya ।",
        "Bhaktibhave Kariti । Vrata Te Tattvata ।। 3 ।।"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "प्रसाद घेऊनी । पतीलागी गेली ।",
        "सत्यनारायणे । कृपा तये केली ।। ४ ।।"
      ],
      "transliteratedLines": [
        "Prasada Gheuni । Patilagi Geli ।",
        "Satyanarayane । Krupa Taye Keli ।। 4 ।।"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "शतानंद विप्र । करितो आरती ।",
        "सत्यनारायणाची । महिमा वर्णीती ।। ५ ।।"
      ],
      "transliteratedLines": [
        "Shatananda Vipra । Karito Arati ।",
        "Satyanarayanachi । Mahima Varniti ।। 5 ।।"
      ]
    }
  ],
