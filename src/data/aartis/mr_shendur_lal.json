      "lines": [
        "शेंदूर लाल चढायो अच्छा गजमुखको ।",
        "दोंदिल लाल बिराजे सुत गौरिहरको ।",
        "हाथ लिये गुडलड्डू सांई सुरवरको ।",
        "महिमा कहे न जाय लागत हूं पदको ॥ १ ॥"
      ],
      "transliteratedLines": [
        "Shendura Lala Chadhayo Achchha Gajamukhako ।",
        "Dondila Lala Biraje Suta Gauriharako ।",
        "Hatha Liye Gudaladdu Sani Suravarako ।",
        "Mahima Kahe Na Jaya Lagata Hun Padako ॥ 1 ॥"
      ]
    },
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय जय जी गणराज विद्या सुखदाता ।",
        "धन्य तुम्हार दर्शन मेरा मन रमता ॥ धृ ॥"
      ],
      "transliteratedLines": [
        "Jaya Jaya Ji Ganaraja Vidya Sukhadata ।",
        "Dhanya Tumhara Darshana Mera Mana Ramata ॥ Dhru ॥"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "अष्टौ सिद्धी दासी संकटको बैरि ।",
        "विघ्नविनाशन मंगल मूरत अधिकारी ।",
        "कोटीसूरजप्रकाश ऐसी छबि तेरी ।",
        "गंडस्थलमदमस्तक झूले शशिबिहारी ॥ २ ॥"
      ],
      "transliteratedLines": [
        "Ashtau Siddhi Dasi Sankatako Bairi ।",
        "Vighnavinashana Mangala Murata Adhikari ।",
        "Kotisurajaprakasha Aisi Chhabi Teri ।",
        "Gandasthalamadamastaka Jhule Shashibihari ॥ 2 ॥"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "भावभगतसे कोई शरणागत आवे ।",
        "संतत संपत सबही भरपूर पावे ।",
        "ऐसे तुम महाराज मोको अति भावे ।",
        "गोसावीनंदन निशिदिन गुन गावे ॥ ३ ॥"
