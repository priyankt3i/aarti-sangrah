  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "उठा पांडुरंगा आतां दर्शन द्या सकळां ।",
        "झाला अरुणोदय सरली निद्रेची वेळा ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Utha Panduranga Atan Darshana Dya Sakaḻan ।",
        "Jhala Arunodaya Sarali Nidrechi Veḻa ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "संत साधू मुनी अवघे झालेती गोळा ।",
        "सोडा शेजे सुख आतां बघूं द्या मुखकमळा ।। १ ।।"
      ],
      "transliteratedLines": [
        "Santa Sadhu Muni Avaghe Jhaleti Goḻa ।",
        "Soda Sheje Sukha Atan Baghun Dya Mukhakamaḻa ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "रंगमंडपी महाद्वारीं झालीसे दाटी ।",
        "मन उतावीळ रूप पहावया दिठी ।। २ ।।"
      ],
      "transliteratedLines": [
        "Rangamandapi Mahadvarin Jhalise Dati ।",
        "Mana Utaviḻa Rupa Pahavaya Dithi ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "राही रखुमाबाई तुम्हां येऊ द्या दया ।",
        "शेजे हालवुनि जागें करा देवराया ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Rahi Rakhumabai Tumhan Yeu Dya Daya ।",
        "Sheje Halavuni Jagen Kara Devaraya ।। 3 ।।"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "गरुड हनुमंत उभे पाहती वाट ।",
        "स्वर्गीचे सुरवर घेउनी आलेती थाट ।। ४ ।।"
      ],
      "transliteratedLines": [
        "Garuda Hanumanta Ubhe Pahati Vata ।",
        "Svargiche Suravara Gheuni Aleti Thata ।। 4 ।।"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "झालें मुक्तद्वार लाभ झाला रोकडा ।",
        "विष्णुदास नामा उभा घेऊनी काकडा ।। ५ ।।"
      ],
      "transliteratedLines": [
        "Jhalen Muktadvara Labha Jhala Rokada ।",
        "Vishnudasa Nama Ubha Gheuni Kakada ।। 5 ।।"
      ]
    }
  ],
  "transliteration": "Kakad Aarti Vitthal (Utha Panduranga Aata)"
