      "isChorus": true,
      "lines": [
        "आरती भुवनसुंदराची । इंदिरावर मुकुंदाची ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Arati Bhuvanasundarachi । Indiravara Mukundachi ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "पद्मसम पादयुग्मरंगा । ओवाळणी होति भृंगा ।",
        "नखमणि श्रवताहे गंगा । जे कां त्रिविधतापभंगा ।।",
        "ऋचालप्र वर्तुळ गुल्फ भ्राजमाने । किंकिणीक्वणितरु",
        "नाद घणघणितरु बांकिवर झुणितरु नेपुरें झनन",
        "मंजिरीची । झनन ध्वनी मंजिरीची ।। १ ।।"
      ],
      "transliteratedLines": [
        "Padmasama Padayugmaranga । Ovaḻani Hoti Bhrunga ।",
        "Nakhamani Shravatahe Ganga । Je Kan Trividhatapabhanga ।।",
        "Ruchalapra Vartuḻa Gulpha Bhrajamane । Kinkinikvanitaru",
        "Nada Ghanaghanitaru Bankivara Jhunitaru Nepuren Jhanana",
        "Manjirichi । Jhanana Dhvani Manjirichi ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "पीतपट हाटकतप्तवर्णी । कांची नितंबसुस्थानीं ।",
        "नाभिची अगाध हो करणी । विश्वजनकाची जे जननी ।।",
        "ऋचालप्र त्रिवलीललित उदरशोभा ।",
        "कुंकुगळां माळ विलम्बितरु झळाळ कौस्तुभरु",
        "सरळ बाहु श्रिवत्स तरल मणि मरळ कंकणाची ।",
        "प्रीति बहुरु जडित कंकणाची ।। २ ।।"
      ],
      "transliteratedLines": [
        "Pitapata Hatakataptavarni । Kanchi Nitanbasusthanin ।",
        "Nabhichi Agadha Ho Karani । Vishvajanakachi Je Janani ।।",
        "Ruchalapra Trivalilalita Udarashobha ।",
        "Kunkugaḻan Maḻa Vilambitaru Jhaḻaḻa Kaustubharu",
        "Saraḻa Bahu Shrivatsa Tarala Mani Maraḻa Kankanachi ।",
        "Priti Bahuru Jadita Kankanachi ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "इंदुसम आस्य कुंदरदना । अधरारुणांकबिंबवदना ।",
        "पाहतां भ्रांति पडे मदना । सजलमेघाब्धि दैत्यदमना ।।",
        "ऋचालप्र झळकत महरकुंडलाभा ।",
        "कुटिल कुंतलीरु मधुरपत्रावली वेष्टिलीरु",
        "तिलक भालिंरु केशरी झळाळित कृष्णकस्तुरीची ।",
        "अक्षता काळी कस्तुरीची ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Indusama Asya Kundaradana । Adhararunankabinbavadana ।",
        "Pahatan Bhranti Pade Madana । Sajalameghabdhi Daityadamana ।।",
        "Ruchalapra Jhaḻakata Maharakundalabha ।",
        "Kutila Kuntaliru Madhurapatravali Veshtiliru",
        "Tilaka Bhalinru Keshari Jhaḻaḻita Krushnakasturichi ।",
        "Akshata Kaḻi Kasturichi ।। 3 ।।"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "कल्पद्रुमातळी मूर्ती । सौदामिनी कोटिदिप्ती ।",
        "गोपीगोपवलयभवंती । त्रिविष्टप पुष्पवृष्टि करिती ।।",
        "ऋचालप्र मंजुळ मधुर मुरलिनदें ।",
        "चकित गंधर्वरु चकित अप्सरारु सुरागिरिवाररु",
        "धरा कर्पुरारतीनें प्रेमयुक्त सची ।"
      ],
      "transliteratedLines": [
        "Kalpadrumataḻi Murti । Saudamini Kotidipti ।",
        "Gopigopavalayabhavanti । Trivishtapa Pushpavrushti Kariti ।।",
        "Ruchalapra Manjuḻa Madhura Muralinaden ।",
        "Chakita Gandharvaru Chakita Apsararu Suragirivararu",
        "Dhara Karpuraratinen Premayukta Sachi ।"
      ]
