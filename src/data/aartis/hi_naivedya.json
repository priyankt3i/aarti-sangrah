  "verses": [
    {
      "id": "v1",
      "lines": [
        "सदा सर्वदा योग तुझा घडावा ।",
        "तुझे कारणी देह माझा पडावा ।",
        "उपेक्षू नको गुणवंता अनंता ।",
        "रघूनायका मागणे हेचि आता ।। १ ।।"
      ],
      "transliteratedLines": [
        "Sada Sarvada Yoga Tujha Ghadava ।",
        "Tujhe Karani Deha Majha Padava ।",
        "Upekshu Nako Gunavanta Ananta ।",
        "Raghunayaka Magane Hechi Ata ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "उपासनेला दृढ चालवावे ।",
        "भूदेव संतासी सदा नमावे ।",
        "सत्कर्म योगे वय घालवावे ।",
        "सर्वामुखी मंगल बोलवावे ।। २ ।।"
      ],
      "transliteratedLines": [
        "Upasanela Drudha Chalavave ।",
        "Bhudeva Santasi Sada Namave ।",
        "Satkarma Yoge Vaya Ghalavave ।",
        "Sarvamukhi Mangala Bolavave ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "कैलास राणा शिव चंद्रमौळी ।",
        "फणींद्र माथा मुकुटी झळाळी ।",
        "कारुण्य सिंधू भवदुःखहारी ।",
        "तुजवीण शंभो मज कोण तारी ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Kailasa Rana Shiva Chandramauli ।",
        "Phanindra Matha Mukuti Jhalali ।",
        "Karunya Sindhu Bhavadukhahari ।",
        "Tujavina Shambho Maja Kona Tari ।। 3 ।।"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "मोरया मोरया मी बाळ तान्हें ।",
        "तुझीच सेवा करु काय जाणे ।",
        "अन्याय माझे कोट्यानुकोटी ।",
        "मोरेश्वरा बा तू घाल पोटी ।। ४ ।।"
      ],
      "transliteratedLines": [
        "Morya Morya Mi Bala Tanhe ।",
        "Tujhicha Seva Karu Kaya Jane ।",
        "Anyaya Majhe Kotyanukoti ।",
        "Moreshwara Ba Tu Ghala Poti ।। 4 ।।"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "ज्या ज्या ठिकाणी मन जाय माझे ।",
        "त्या त्या ठिकाणी निजरूप तुझे ।",
        "मी ठेवितो मस्तक ज्या ठिकाणी ।",
        "तेथे तुझे सद्गुरु पाय दोन्ही ।। ५ ।।"
      ],
      "transliteratedLines": [
        "Jya Jya Thikani Mana Jaya Majhe ।",
        "Tya Tya Thikani Nijarupa Tujhe ।",
        "Mi Thevito Mastaka Jya Thikani ।",
        "Tethe Tujhe Sadguru Paya Donhi ।। 5 ।।"
      ]
    },
    {
      "id": "v6",
      "lines": [
        "अलंकापुरी पुण्य भूमी पवित्र ।",
        "तिथे नांदतो ज्ञानराजा सुपात्र ।",
        "तया आठविता महापुण्यराशी ।",
        "नमस्कार माझा सद्गुरु ज्ञानेश्वराशी ।। ६ ।।"
      ],
      "transliteratedLines": [
        "Alankapuri Punya Bhumi Pavitra ।",
        "Tithe Nandato Dnyanaraja Supatra ।",
        "Taya Athavita Mahapunyarashi ।",
        "Namaskara Majha Sadguru Dnyaneshwarashi ।। 6 ।।"
      ]
    }
  ],
  "transliteration": "Naivedya (Sada Sarvada Yoga Tuza Ghadava)"
