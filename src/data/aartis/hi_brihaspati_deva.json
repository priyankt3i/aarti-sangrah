  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "ॐ जय बृहस्पति देवा, स्वामी जय बृहस्पति देवा ।",
        "छिन छिन भोग लगाऊँ, कदली फल मेवा ॥",
        "ॐ जय बृहस्पति देवा ॥"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "तुम पूर्ण परमात्मा, तुम अन्तर्यामी ।",
        "जगतपिता जगदीश्वर, तुम सबके स्वामी ॥",
        "ॐ जय बृहस्पति देवा ॥ १ ॥"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "चरण पादुका कञ्चन, सुवर्ण सिंहासन ।",
        "पीताम्बर परिधान, पीत ही चन्दन ॥",
        "ॐ जय बृहस्पति देवा ॥ २ ॥"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "गलगल कुण्डल सोहे, कुञ्चित केश अति ।",
        "कर माला कमण्डलु, ज्ञान रूप गति ॥",
        "ॐ जय बृहस्पति देवा ॥ ३ ॥"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "सकल मनोरथ दायक, सब संशय हरता ।",
        "जो जन ध्यावे तुमको, भवसागर तरता ॥",
        "ॐ जय बृहस्पति देवा ॥ ४ ॥"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "बृहस्पति देव की आरती, जो कोई नर गावे ।",
        "कहत शिवानन्द स्वामी, मनवांछित फल पावे ॥",
        "ॐ जय बृहस्पति देवा ॥ ५ ॥"
      ]
    }
  ],
  "transliteration": "Om Jai Brihaspati Deva (Om Jai Brihaspati Deva, Brihaspati Aarti)"
}
