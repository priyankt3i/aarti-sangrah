        "आरती तुकारामा । स्वामी सद्गुरुधामा ।।",
        "सच्चिदानंद मूर्ती । पाय दाखवी आम्हां ।। धृ ।। "
      ],
      "transliteratedLines": [
        "Arati Tukarama । Svami Sadgurudhama ।।",
        "Sachchidananda Murti । Paya Dakhavi Amhan ।। Dhru ।। "
      ]
    },
    {
      "id": "v1",
      "lines": [
        "राघवें सागरांत । पाषाण तारीले ।।",
        "तैसे हे तुकोबाचे । अभंग उदकीं रक्षिले ।। १ ।। "
      ],
      "transliteratedLines": [
        "Raghaven Sagaranta । Pashana Tarile ।।",
        "Taise He Tukobache । Abhanga Udakin Rakshile ।। 1 ।। "
      ]
    },
    {
      "id": "v2",
      "lines": [
