  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय वैष्णवी माता, मैया जय वैष्णवी माता ।",
        "हाथ जोड़ तेरे आगे, आरती मैं गाता ॥",
        "जय वैष्णवी माता ॥"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "शीश पे छत्र विराजे, मूरत अति प्यारी ।",
        "गंगा जमुना सरस्वती, चरनन जल धारी ॥",
        "जय वैष्णवी माता ॥ १ ॥"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "त्रिकूट पर्वत वासिनी, भवन तुम्हारा है ।",
        "महाकाली महालक्ष्मी, महासरस्वती का वास है ॥",
        "जय वैष्णवी माता ॥ २ ॥"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "भैरव को वर दीन्हा, पावन धाम किया ।",
        "जो जन द्वारे आया, सब कुछ प्राप्त किया ॥",
        "जय वैष्णवी माता ॥ ३ ॥"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "चम्पा चमेली गेंदा, पुष्प चढ़े भारी ।",
        "नारियल और चुनरी, भेंट करें सारी ॥",
        "जय वैष्णवी माता ॥ ४ ॥"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "आरती जो कोई गावे, सुख सम्पत्ति पावे ।",
        "वैष्णो देवी मैया, भव पार लगावे ॥",
        "जय वैष्णवी माता ॥ ५ ॥"
      ]
    }
  ]
}
