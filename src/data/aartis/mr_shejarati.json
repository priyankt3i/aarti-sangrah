      "transliteratedLines": [
        "Atan Svami Sukhen Nidra Kara Gopaḻa ।",
        "Puravilen Manoratha Puravili Kaḻakaḻa ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "दिसभर श्रमलासी भक्तांच्या संगे ।",
        "गोकुळीं गाई राखिल्या श्रीरंगे ।। १ ।।"
      ],
      "transliteratedLines": [
        "Disabhara Shramalasi Bhaktanchya Sange ।",
        "Gokuḻin Gai Rakhilya Shrirange ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "चंदनाची शेज केलीसे मनोहर ।",
        "पुष्पांच्या मखरांत निज रे सुंदर ।। २ ।।"
      ],
      "transliteratedLines": [
        "Chandanachi Sheja Kelise Manohara ।",
        "Pushpanchya Makharanta Nija Re Sundara ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "राही रखुमाबाई चरणांशी सेवा ।",
        "नामदेव ओवाळी विठ्ठल जीवा ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Rahi Rakhumabai Charananshi Seva ।",
        "Namadeva Ovaḻi Viththala Jiva ।। 3 ।।"
      ]
