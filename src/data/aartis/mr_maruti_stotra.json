  "verses": [
    {
      "id": "v1",
      "lines": [
        "भीमरूपी महारुद्रा वज्रहनुमान मारुती ।",
        "वनारी अंजनीसूता रामदूता प्रभंजना ।। १ ।।"
      ],
      "transliteratedLines": [
        "Bhimarupi Maharudra Vajrahanumana Maruti ।",
        "Vanari Anjanisuta Ramaduta Prabhanjana ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "महाबळी प्राणदाता दीनानाथां कैवारिया ।",
        "पुण्यवंत पुण्यशीला पावना परितोषका ।। २ ।।"
      ],
      "transliteratedLines": [
        "Mahabaḻi Pranadata Dinanathan Kaivariya ।",
        "Punyavanta Punyashila Pavana Paritoshaka ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "ध्वजांगे उचली बाहो आवेशें लोटला पुढें ।",
        "काळाग्नि काळरुद्राग्नि देखतां कापती भयें ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Dhvajange Uchali Baho Aveshen Lotala Pudhen ।",
        "Kaḻagni Kaḻarudragni Dekhatan Kapati Bhayen ।। 3 ।।"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "ब्रह्मांड माईले नेणों आवळे दंतपंगती ।",
        "नेत्राग्नि चालिल्या ज्वाळा भ्रुकुटी ताठिल्या बळें ।। ४ ।।"
      ],
      "transliteratedLines": [
        "Brahmanda Maile Nenon Avaḻe Dantapangati ।",
        "Netragni Chalilya Jvaḻa Bhrukuti Tathilya Baḻen ।। 4 ।।"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "पुच्छ तें मुरडिलें माथां किरीटी कुंडलें बरीं ।",
        "सुवर्ण कटिकांसोटी घंटा किंकिणी नागरा ।। ५ ।।"
      ],
      "transliteratedLines": [
        "Puchchha Ten Muradilen Mathan Kiriti Kundalen Barin ।",
        "Suvarna Katikansoti Ghanta Kinkini Nagara ।। 5 ।।"
      ]
    },
    {
      "id": "v6",
      "lines": [
        "ठकारे पर्वताऐसा नेटका सडपातळू ।",
        "चपळांग पाहतां मोठे महाविद्युल्लतेपरी ।। ६ ।।"
      ],
      "transliteratedLines": [
        "Thakare Parvataaisa Netaka Sadapataḻu ।",
        "Chapaḻanga Pahatan Mothe Mahavidyullatepari ।। 6 ।।"
      ]
    },
    {
      "id": "v7",
      "lines": [
        "कोटिच्या कोटि उड्डाणें झेपावे उत्तरेकडे ।",
        "मंद्राद्रीसारिखा द्रोणू क्रोधें उत्पाटिला बळें ।। ७ ।।"
      ],
      "transliteratedLines": [
        "Kotichya Koti Uddanen Jhepave Uttarekade ।",
        "Mandradrisarikha Dronu Krodhen Utpatila Baḻen ।। 7 ।।"
      ]
    },
    {
      "id": "v8",
      "lines": [
        "आणिता मागुतीं नेला आला गेला मनोगती ।",
        "मनासी टाकिलें मागें गतीसी तूळणा नसे ।। ८ ।।"
      ],
      "transliteratedLines": [
        "Anita Magutin Nela Ala Gela Manogati ।",
        "Manasi Takilen Magen Gatisi Tuḻana Nase ।। 8 ।।"
      ]
    },
    {
      "id": "v9",
      "lines": [
        "अणूपासोनि ब्रह्मांडाएवढा होत जातसे ।",
        "तयासी तुळणा कोठें मेरुमांदार धाकुटे ।। ९ ।।"
      ],
      "transliteratedLines": [
        "Anupasoni Brahmandaevadha Hota Jatase ।",
        "Tayasi Tuḻana Kothen Merumandara Dhakute ।। 9 ।।"
      ]
    },
    {
      "id": "v10",
      "lines": [
        "ब्रह्मांडाभोंवते वेढे वज्रपुच्छें करूं शके ।",
        "तयासी तुळणा कैंची ब्रह्मांडी पाहतां नसे ।। १० ।।"
      ],
      "transliteratedLines": [
        "Brahmandabhonvate Vedhe Vajrapuchchhen Karun Shake ।",
        "Tayasi Tuḻana Kainchi Brahmandi Pahatan Nase ।। 10 ।।"
      ]
    },
    {
      "id": "v11",
      "lines": [
        "आरक्त देखिलें डोळां ग्रासिलें सूर्यमंडळा ।",
        "वाढतां वाढतां वाढे भेदिलें शून्यमंडळा ।। ११ ।।"
      ],
      "transliteratedLines": [
        "Arakta Dekhilen Doḻan Grasilen Suryamandaḻa ।",
        "Vadhatan Vadhatan Vadhe Bhedilen Shunyamandaḻa ।। 11 ।।"
      ]
    },
    {
      "id": "v12",
      "lines": [
        "धनधान्य पशूवृद्धि पुत्रपौत्र समग्रही ।",
        "पावती रूपविद्यादी स्तोत्रपाठें करूनियां ।। १२ ।।"
      ],
      "transliteratedLines": [
        "Dhanadhanya Pashuvruddhi Putrapautra Samagrahi ।",
        "Pavati Rupavidyadi Stotrapathen Karuniyan ।। 12 ।।"
      ]
    },
    {
      "id": "v13",
      "lines": [
        "भूतप्रेतसमंधादी रोगव्याधी समस्तही ।",
        "नासती तूटती चिंता आनंदें भीमदर्शने ।। १३ ।।"
      ],
      "transliteratedLines": [
        "Bhutapretasamandhadi Rogavyadhi Samastahi ।",
        "Nasati Tutati Chinta Ananden Bhimadarshane ।। 13 ।।"
      ]
    },
    {
      "id": "v14",
      "lines": [
        "हे धरा पंधराश्लोकी लाभली शोभली भली ।",
        "दृढदेहो निसंदेहो संख्या चंद्रकळा गुणें ।। १४ ।।"
      ],
      "transliteratedLines": [
        "He Dhara Pandharashloki Labhali Shobhali Bhali ।",
        "Drudhadeho Nisandeho Sankhya Chandrakaḻa Gunen ।। 14 ।।"
      ]
    },
    {
      "id": "v15",
      "lines": [
        "रामदासी अग्रगण्यू कपिकुळासि मंडणू ।",
        "रामरूपी अंतरात्मा दर्शने दोष नासती ।। १५ ।।"
      ],
      "transliteratedLines": [
        "Ramadasi Agraganyu Kapikuḻasi Mandanu ।",
        "Ramarupi Antaratma Darshane Dosha Nasati ।। 15 ।।"
      ]
    }
  ],
  "transliteration": "Maruti Stotra (Bhimrupi Maharudra / Hanuman Stotra)"
}
