  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "ॐ जय यक्ष कुबेरा, स्वामी जय यक्ष कुबेरा ।",
        "तुमको निसदिन ध्यावत, सेवक सुख पाता ॥",
        "ॐ जय यक्ष कुबेरा ॥"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "शिव पद वंदत स्वामी, तुम हो धन दाता ।",
        "अष्ट सिद्धि नवनिधि, तुमरे वश आता ॥",
        "ॐ जय यक्ष कुबेरा ॥ १ ॥"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "अलकापुरी के स्वामी, खजाना भर दीजै ।",
        "दरिद्र दुख हर कर, प्रभु कृपा कीजै ॥",
        "ॐ जय यक्ष कुबेरा ॥ २ ॥"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "रत्न सुवर्ण भूषण, प्रभु तुमरे सोहे ।",
        "भक्त जनों की विनती, सुन मन अति मोहे ॥",
        "ॐ जय यक्ष कुबेरा ॥ ३ ॥"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "कुबेर देव की आरती, जो कोई जन गावे ।",
        "सुख सम्पत्ति वैभव, सकल मनोरथ पावे ॥",
        "ॐ जय यक्ष कुबेरा ॥ ४ ॥"
      ]
    }
  ]
