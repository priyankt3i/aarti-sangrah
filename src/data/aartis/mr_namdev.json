      "isChorus": true,
      "lines": [
        "आरती नामदेवा । मुनिजनविश्रामा ।",
        "सकळसंतसख्या । पंढरीनिवासा ।। धृ ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "नामदेव कीर्तन करी । पुढें देव नाचे पांडुरंग ।",
        "जनी म्हणे देवा । माझा नाम्या रंगला ।। १ ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "निर्गुणाचे भेटी । आलो सगुणाचे संगे ।",
        "तुकयाबंधु म्हणे । नाम्या तारिले जगीं ।। २ ।।"
      ]
    }
  ],
  "transliteration": "Shree Namdev Aarti (Aarti Namdeva / Sant Namdev)"
