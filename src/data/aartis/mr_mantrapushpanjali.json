  "verses": [
    {
      "id": "v1",
      "lines": [
        "ॐ यज्ञेन यज्ञमयजन्त देवास्तानि धर्माणि प्रथमान्यासन् ।",
        "ते ह नाकं महिमान: सचन्त यत्र पूर्वे साध्या: सन्ति देवा: ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "ॐ राजाधिराजाय प्रसह्यसाहिने । नमो वयं वैश्रवणाय कुर्महे ।",
        "स मे कामान् कामकामाय मह्यम् । कामेश्वरो वैश्रवणो ददातु ।",
        "कुबेराय वैश्रवणाय महाराजाय नम: ।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "ॐ स्वस्ति साम्राज्यं भौज्यं स्वाराज्यं वैराज्यं",
        "पारमेष्ठ्यं राज्यं महाराज्यमाधिपत्यमयं समन्तपर्यायी",
        "स्यात्सार्वभौम: सार्वायुष आन्तादापरार्धात्पृथिव्यै",
        "समुद्रपर्यन्ताया एकराळिति ।"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "तदप्येष श्लोकोऽभिगीतो मरुत: परिवेष्टारो",
        "मरुत्तस्यावसन् गृहे । आविक्षितस्य कामप्रेर्विश्वेदेवा: सभासद इति ।।"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "एकदंताय विद्महे वक्रतुण्डाय धीमहि । तन्नो दन्ती प्रचोदयात् ।।"
      ]
    }
  ]
}
