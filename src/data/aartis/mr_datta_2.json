      "lines": [
        "आरती स्वामीदत्ता । आरती स्वामीदत्ता ।",
        "अघहरणा तू तारक भक्ता ।। धृ ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "अत्रीच्या कुळी जन्मसी । माय अनुसया मातेसी ।",
        "अवतार घेऊनी कैसी । लीला दाविसी जगासी ।। १ ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "दत्त दिगंबर रूप । पाहता हरेल पाप ।",
        "त्रैमूर्ती अवतार । भक्तासी देई ताप ।। २ ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "एका जनार्दनी । चरणी मस्तक ठेविले ।",
        "तुझे रूप पाहुनी । मन माझे रमिले ।। ३ ।।"
      ]
    }
  ]
