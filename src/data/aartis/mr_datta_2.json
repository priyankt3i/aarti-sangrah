    {
      "id": "v1",
      "lines": [
        "अत्रीच्या कुळी जन्मसी । माय अनुसया मातेसी ।",
        "अवतार घेऊनी कैसी । लीला दाविसी जगासी ।। १ ।।"
      ],
      "transliteratedLines": [
        "Atrichya Kuḻi Janmasi । Maya Anusaya Matesi ।",
        "Avatara Gheuni Kaisi । Lila Davisi Jagasi ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "दत्त दिगंबर रूप । पाहता हरेल पाप ।",
