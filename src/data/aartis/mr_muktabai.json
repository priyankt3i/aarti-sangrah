      "isChorus": true,
      "lines": [
        "आरती मुक्ताबाई । ज्ञानियांची धाकुली ताई ।",
        "ताटीचे अभंग गाऊनी । ज्ञानदेवा चेतविसी लवलाही ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Arati Muktabai । Jnyaniyanchi Dhakuli Tai ।",
        "Tatiche Abhanga Gauni । Jnyanadeva Chetavisi Lavalahi ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "लहानपणी विरक्ती मोठी । ब्रह्मज्ञान वसे कंठी ।",
        "गोरक्षनाथांची भेट । केली तापीतीराच्या तटी ।। १ ।।"
      ],
      "transliteratedLines": [
        "Lahanapani Virakti Mothi । Brahmajnyana Vase Kanthi ।",
        "Gorakshanathanchi Bheta । Keli Tapitirachya Tati ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "मुक्ताबाई महायोगिनी । मुक्ताबाई माझी माउली ।",
        "नामदेव चरणी लीन । कृपा तुझी मज लाभली ।। २ ।।"
      ],
      "transliteratedLines": [
        "Muktabai Mahayogini । Muktabai Majhi Mauli ।",
        "Namadeva Charani Lina । Krupa Tujhi Maja Labhali ।। 2 ।।"
      ]
    }
