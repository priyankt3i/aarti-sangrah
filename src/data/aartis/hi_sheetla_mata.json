  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय शीतला माता, मैया जय शीतला माता ।",
        "आदि ज्योति महारानी, सब सुख की दाता ॥",
        "जय शीतला माता ॥"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "रतन सिंहासन शोभित, श्वेत छत्र भ्राजे ।",
        "ऋद्धि-सिद्धि चँवर ढुलावें, सुर-मुनि जन ध्यावे ॥",
        "जय शीतला माता ॥ १ ॥"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "गर्दभ वाहन सोहे, झाडू कर कर धारी ।",
        "कलश कलधौत हाथ में, शीतलता प्यारी ॥",
        "जय शीतला माता ॥ २ ॥"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "शीतल अंग सुहावन, ज्वर भय सब नाशे ।",
        "जो जन शरण तुम्हारी, संकट कट जावे ॥",
        "जय शीतला माता ॥ ३ ॥"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "शीतला माता की आरती, जो जन नित गावे ।",
        "निरोगी काया पाकर, परम सुख पावे ॥",
        "जय शीतला माता ॥ ४ ॥"
      ]
    }
  ]
}
