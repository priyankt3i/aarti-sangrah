  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय देव जय देव जय गजानना ।",
        "सद्गुरु गजानना ।",
        "आरती ओवाळू चरणकरकमला ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Jaya Deva Jaya Deva Jaya Gajanana ।",
        "Sadguru Gajanana ।",
        "Arati Ovaḻu Charanakarakamala ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "जय जय सत्चित्स्वरूपा स्वामी गणराया ।",
        "अवतरलासी भूवर जड-मूढ ताराया ।। १ ।।"
      ],
      "transliteratedLines": [
        "Jaya Jaya Satchitsvarupa Svami Ganaraya ।",
        "Avataralasi Bhuvara Jada-mudha Taraya ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "निर्गुण ब्रह्म सनातन अव्यय अविनाशी ।",
        "स्थिरचर व्यापून उरले जे या जगताशी ।। २ ।।"
      ],
      "transliteratedLines": [
        "Nirguna Brahma Sanatana Avyaya Avinashi ।",
        "Sthirachara Vyapuna Urale Je Ya Jagatashi ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "ते तूं तत्त्व खरोखर नि:संशय अससी ।",
        "लीलामात्रें धरिलें मानव देहासी ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Te Tun Tattva Kharokhara Ni:sanshaya Asasi ।",
        "Lilamatren Dharilen Manava Dehasi ।। 3 ।।"
      ]
    },
    {
      "id": "v4",
      "lines": [
        "भक्तजनांस्तव माते तूं हे वसविलें ।",
        "शेगांव-ग्राम अतीव पुण्यमय केलें ।। ४ ।।"
      ],
      "transliteratedLines": [
        "Bhaktajananstava Mate Tun He Vasavilen ।",
        "Sheganva-grama Ativa Punyamaya Kelen ।। 4 ।।"
      ]
    },
    {
      "id": "v5",
      "lines": [
        "दास गणू म्हणे स्वामी कृपा करीं आम्हां ।",
        "सकळिक जनांसी रक्षीं पावुनियां प्रेमा ।। ५ ।।"
      ],
      "transliteratedLines": [
        "Dasa Ganu Mhane Svami Krupa Karin Amhan ।",
        "Sakaḻika Janansi Rakshin Pavuniyan Prema ।। 5 ।।"
      ]
    }
  ],
  "transliteration": "Shree Gajanan Maharaj Aarti (Shegaon Gajanan Maharaj / Jay Jay Satchitswarupa)"
