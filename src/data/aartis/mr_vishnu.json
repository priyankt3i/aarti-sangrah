    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "नवल होताहे आरती देवाधिदेवा ।",
        "स्वर्गीहुनी सुरवर पाहूं येती केशवा ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Navala Hotahe Arati Devadhideva ।",
        "Svargihuni Suravara Pahun Yeti Keshava ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "संतसनकादिक भक्त मिळाले अनेक ।",
        "स्वानंदें गर्जती पाहूं आले कौतुक ।। १ ।।"
      ],
      "transliteratedLines": [
        "Santasanakadika Bhakta Miḻale Aneka ।",
        "Svananden Garjati Pahun Ale Kautuka ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "नर नारी तटस्थ टक पडिलें नयना ।",
        "ओवाळीतां श्रीमुख धणी न पुरे मना ।। २ ।।"
      ],
      "transliteratedLines": [
        "Nara Nari Tatastha Taka Padilen Nayana ।",
        "Ovaḻitan Shrimukha Dhani Na Pure Mana ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "एका जनार्दनीं मंगल आरत्या गाती ।",
        "मंगल कौतुकें गाती ।",
        "मिळाले वैष्णव जयजयकारें गर्जती ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Eka Janardanin Mangala Aratya Gati ।",
        "Mangala Kautuken Gati ।",
        "Miḻale Vaishnava Jayajayakaren Garjati ।। 3 ।।"
      ]
    }
  ],
