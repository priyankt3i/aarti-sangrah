      "lines": [
        "सुखकर्ता दुःखहर्ता वार्ता विघ्नाची ।",
        "नुरवी पुरवी प्रेम कृपा जयाची ।",
        "सर्वांगी सुंदर उटी शेंदुराची ।",
        "कंठी झळके माळ मुक्ताफळाची ॥ १ ॥"
      ],
      "transliteratedLines": [
        "Sukhakarta Duhkhaharta Varta Vighnachi ।",
        "Nuravi Puravi Prema Krupa Jayachi ।",
        "Sarvangi Sundara Uti Shendurachi ।",
        "Kanthi Jhaḻake Maḻa Muktaphaḻachi ॥ 1 ॥"
      ]
    },
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
