      "id": "c1",
      "isChorus": true,
      "lines": [
        "आरती सोपानदेवा । सासवडनिवासी जीवा ।",
        "ज्ञानियांचा बंधू राजा । चरणीं भावें करितो सेवा ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Arati Sopanadeva । Sasavadanivasi Jiva ।",
        "Jnyaniyancha Bandhu Raja । Charanin Bhaven Karito Seva ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "सोपानकाका अवधूत । कऱ्हेच्या तीरावरती ।",
        "समाधिस्थ योगिराज । भक्तां संकटीं तारीती ।। १ ।।"
      ],
      "transliteratedLines": [
        "Sopanakaka Avadhuta । Kaऱhechya Tiravarati ।",
        "Samadhistha Yogiraja । Bhaktan Sankatin Tariti ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "सोपानदेवांची आरती । जो कोणी गाईल चित्ती ।",
        "त्यासी लाभे मोक्षपद । नामदेव वंदी नित्य भक्ती ।। २ ।।"
      ],
      "transliteratedLines": [
        "Sopanadevanchi Arati । Jo Koni Gaila Chitti ।",
        "Tyasi Labhe Mokshapada । Namadeva Vandi Nitya Bhakti ।। 2 ।।"
      ]
    }
  ],
