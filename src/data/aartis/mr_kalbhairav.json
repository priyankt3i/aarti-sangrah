      "isChorus": true,
      "lines": [
        "जय देव जय देव जय काळभैरवा ।",
        "आरती ओवाळूं तुज आदिदेवा ।। धृ ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "काशीचा कोतवाल त्रिशूळ डमरू हातीं ।",
        "काळाचाही काळ भक्तां रक्षणार्थी ।। १ ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "श्वानवाहन शोभे दिगंबर वेषा ।",
        "भस्म अंगीं चर्चिलें नाशी दुर्वासा ।। २ ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "शरण आलों तुजला देई अभयदान ।",
        "भैरवाच्या चरणीं लीन भक्तांचे मन ।। ३ ।।"
      ]
    }
  ],
  "transliteration": "Shree Kalbhairav Aarti (Jay Dev Kalbhairava)"
