      "id": "v1",
      "lines": [
        "दुर्गे दुर्घट भारी तुजविण संसारी ।",
        "अनाथ नाथे अंबे करुणा विस्तारी ।",
        "वारी वारी जन्ममरणांते वारी ।",
        "हारी पडलो आता संकट निवारी ॥ १ ॥"
      ],
      "transliteratedLines": [
        "Durge Durghata Bhari Tujavina Sansari ।",
        "Anatha Nathe Anbe Karuna Vistari ।",
        "Vari Vari Janmamaranante Vari ।",
        "Hari Padalo Ata Sankata Nivari ॥ 1 ॥"
      ]
    },
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय देवी जय देवी महिषासुरमथिनी ।",
        "सुरवरईश्वरवरदे तारक संजीवनी ॥ जय देवी ॥"
      ],
      "transliteratedLines": [
        "Jaya Devi Jaya Devi Mahishasuramathini ।",
        "Suravaraishvaravarade Taraka Sanjivani ॥ Jaya Devi ॥"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "त्रिभुवनी भुवनी पाहता तुज ऐसे नाही ।",
        "चारी श्रमले परंतु न बोलवे काही ।",
        "साही विवाद करिता पडले प्रवाही ।",
        "ते तू भक्तालागी पावसि लवलाही ॥ २ ॥"
      ],
      "transliteratedLines": [
        "Tribhuvani Bhuvani Pahata Tuja Aise Nahi ।",
        "Chari Shramale Parantu Na Bolave Kahi ।",
        "Sahi Vivada Karita Padale Pravahi ।",
        "Te Tu Bhaktalagi Pavasi Lavalahi ॥ 2 ॥"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "प्रसन्न वदने प्रसन्न होसी निजदासा ।",
        "क्लेशांपासुनी सोडी तोडी भवपाशा ।",
        "अंबे तुजवाचून कोण पुरवील आशा ।",
        "नरहरी तल्लीन झाला पदपंकजलेशा ॥ ३ ॥"
      ],
      "transliteratedLines": [
        "Prasanna Vadane Prasanna Hosi Nijadasa ।",
        "Kleshanpasuni Sodi Todi Bhavapasha ।",
        "Anbe Tujavachuna Kona Puravila Asha ।",
        "Narahari Tallina Jhala Padapankajalesha ॥ 3 ॥"
      ]
    }
  ],
