      "lines": [
        "कांकड आरति माझ्या कृष्ण सभागिया ।",
        "चराचर मोहरलें तुझी मूर्ती पहाया ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Kankada Arati Majhya Krushna Sabhagiya ।",
        "Charachara Moharalen Tujhi Murti Pahaya ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "सहस्रदीपें दीप कैसी प्रकाशाळी प्रभा ।",
        "उजळल्या दशदिशा गगना आलीसे शोभा ।। १ ।।"
      ],
      "transliteratedLines": [
        "Sahasradipen Dipa Kaisi Prakashaḻi Prabha ।",
        "Ujaḻalya Dashadisha Gagana Alise Shobha ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "कोंदलेंसे तेज प्रभा झालीसे एक ।",
        "नित्य नवा आनंद ओवाळितां श्रीमुख ।। २ ।।"
      ],
      "transliteratedLines": [
        "Kondalense Teja Prabha Jhalise Eka ।",
        "Nitya Nava Ananda Ovaḻitan Shrimukha ।। 2 ।।"
      ]
    },
    {
      "id": "v3",
      "lines": [
        "आरति करितां तेज प्रकाशलें नयनीं ।",
        "तेणें तेजें मीनला एका एकीं जनार्दनीं ।। ३ ।।"
      ],
      "transliteratedLines": [
        "Arati Karitan Teja Prakashalen Nayanin ।",
        "Tenen Tejen Minala Eka Ekin Janardanin ।। 3 ।।"
      ]
