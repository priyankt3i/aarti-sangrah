  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "ओवाळूं आरती मदनगोपाळा ।",
        "श्यामसुंदर गळा वैजयंतीमाळा ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Ovaḻun Arati Madanagopaḻa ।",
        "Shyamasundara Gaḻa Vaijayantimaḻa ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "चरणकमल ज्याचे अति सुकुमार ।",
        "ध्वजवज्रांकुश ब्रीदाते तोडर ।। १ ।। "
      ],
      "transliteratedLines": [
        "Charanakamala Jyache Ati Sukumara ।",
        "Dhvajavajrankusha Bridate Todara ।। 1 ।। "
      ]
    },
    {
      "id": "v2",
      "lines": [
        "नाभिकमळीं ज्याचें ब्रह्माचें स्थान ।",
        "हृदया पदक शोभे श्रीवत्सलांछन ।। २ ।। "
      ],
      "transliteratedLines": [
        "Nabhikamaḻin Jyachen Brahmachen Sthana ।",
        "Hrudaya Padaka Shobhe Shrivatsalanchhana ।। 2 ।। "
      ]
    },
    {
      "id": "v3",
      "lines": [
        "मुखकमल पाहातां सूर्याच्याकोटी ।",
        "मोहियेलें मानस कोंदियली दृष्टी ।। ३ ।। "
      ],
      "transliteratedLines": [
        "Mukhakamala Pahatan Suryachyakoti ।",
        "Mohiyelen Manasa Kondiyali Drushti ।। 3 ।। "
      ]
    },
    {
      "id": "v4",
      "lines": [
        "जडितमुगुट ज्याच्या देदीप्यमान ।",
        "तेणें तेजें कोंदलें अवघे त्रिभुवन ।। ४ ।। "
      ],
      "transliteratedLines": [
        "Jaditamuguta Jyachya Dedipyamana ।",
        "Tenen Tejen Kondalen Avaghe Tribhuvana ।। 4 ।। "
      ]
    },
    {
      "id": "v5",
      "lines": [
        "एका जनार्दनीं देखियले रूप ।",
        "रूप पाहों जातां झालेंसें तद्रूप ।। ५ ।। "
      ],
      "transliteratedLines": [
        "Eka Janardanin Dekhiyale Rupa ।",
        "Rupa Pahon Jatan Jhalensen Tadrupa ।। 5 ।। "
      ]
    }
  ],
  "transliteration": "Shree Krishna Aarti 1 (Owalu Aarti Madangopala)"
