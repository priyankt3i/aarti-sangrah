  "verses": [
    {
      "id": "v1",
      "lines": [
        "वेदांचें जें गुह्य शास्त्रांचें जें सार ।",
        "प्राकृत शब्दांमाजी केला विस्तार ।",
        "कर्म उपासना ज्ञान गंभीर ।",
        "ज्याच्या मननमात्रें आत्मा गोचर ।। १ ।।"
      ],
      "transliteratedLines": [
        "Vedanchen Jen Guhya Shastranchen Jen Sara ।",
        "Prakruta Shabdanmaji Kela Vistara ।",
        "Karma Upasana Jnyana Ganbhira ।",
        "Jyachya Mananamatren Atma Gochara ।। 1 ।।"
      ]
    },
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय देव जय देव जय मनोबोधा ।",
        "पंचप्राणें आरति तुज स्वात्मशुद्धा ।।",
        "जय देव जय देव ।।"
      ],
      "transliteratedLines": [
        "Jaya Deva Jaya Deva Jaya Manobodha ।",
        "Panchapranen Arati Tuja Svatmashuddha ।।",
        "Jaya Deva Jaya Deva ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "दोन शतें पांच श्लोक हे जाण ।",
        "श्रवणें अर्थें साधक पावति हे खूण ।।",
        "परमार्थासी सुलभ मार्ग हा पूर्ण ।",
        "यशवंत सद्गुरु दासाचा प्राण ।।",
        "जय देव जय देव ।।"
      ],
      "transliteratedLines": [
        "Dona Shaten Pancha Shloka He Jana ।",
        "Shravanen Arthen Sadhaka Pavati He Khuna ।।",
        "Paramarthasi Sulabha Marga Ha Purna ।",
        "Yashavanta Sadguru Dasacha Prana ।।",
        "Jaya Deva Jaya Deva ।।"
      ]
    }
  ],
