      "id": "c1",
      "isChorus": true,
      "lines": [
        "आरती तुकारामा । स्वामी सद्गुरुधामा ।",
        "सच्चिदानंदमूर्ती । पाय दाखवीं आम्हां ।। धृ ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "राघवें सागरांत । पाषाण तारिले ।",
        "तैसे हे तुकोबाचे । अभंग उदकीं रक्षिले ।। १ ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "तुकितां तुलनेसी । ब्रह्म तुकासी आले ।",
        "म्हणोनि रामेश्वरे । चरणीं मस्तक ठेविले ।। २ ।।"
      ]
    }
  ]
