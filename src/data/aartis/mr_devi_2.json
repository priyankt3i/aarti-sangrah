  "verses": [
    {
      "id": "c1",
      "isChorus": true,
      "lines": [
        "जय देवी जय देवी महिषासुरमर्दिनी ।",
        "सुरवरईश्वरवरदे तारक भवानी ।। धृ ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "त्रिभुवनभुवनी पाहता तुजऐसी नाही ।",
        "चारी श्रमले परंतु न बोलवे काही ।",
        "साही विवाद करिता पडले प्रवाही ।",
        "ते तू भक्तालागी पावसी लवलाही ।। १ ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "प्रसन्न वदने प्रसन्न होसी निजदासा ।",
        "क्लेशापासूनि सोडवी तोडी भवपाशा ।",
        "अंबे तुजवाचून कोण पुरवील आशा ।",
        "नरहरी तल्लीन झाला पदपंकजलेशा ।। २ ।।"
      ]
    }
  ]
}
