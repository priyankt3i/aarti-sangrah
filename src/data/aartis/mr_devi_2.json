      "isChorus": true,
      "lines": [
        "जय देवी जय देवी महिषासुरमर्दिनी ।",
        "सुरवरईश्वरवरदे तारक भवानी ।। धृ ।।"
      ],
      "transliteratedLines": [
        "Jaya Devi Jaya Devi Mahishasuramardini ।",
        "Suravaraishvaravarade Taraka Bhavani ।। Dhru ।।"
      ]
    },
    {
      "id": "v1",
      "lines": [
        "त्रिभुवनभुवनी पाहता तुजऐसी नाही ।",
        "चारी श्रमले परंतु न बोलवे काही ।",
        "साही विवाद करिता पडले प्रवाही ।",
        "ते तू भक्तालागी पावसी लवलाही ।। १ ।।"
      ],
      "transliteratedLines": [
        "Tribhuvanabhuvani Pahata Tujaaisi Nahi ।",
        "Chari Shramale Parantu Na Bolave Kahi ।",
        "Sahi Vivada Karita Padale Pravahi ।",
        "Te Tu Bhaktalagi Pavasi Lavalahi ।। 1 ।।"
      ]
    },
    {
      "id": "v2",
      "lines": [
        "प्रसन्न वदने प्रसन्न होसी निजदासा ।",
        "क्लेशापासूनि सोडवी तोडी भवपाशा ।",
        "अंबे तुजवाचून कोण पुरवील आशा ।",
        "नरहरी तल्लीन झाला पदपंकजलेशा ।। २ ।।"
      ],
      "transliteratedLines": [
        "Prasanna Vadane Prasanna Hosi Nijadasa ।",
        "Kleshapasuni Sodavi Todi Bhavapasha ।",
        "Anbe Tujavachuna Kona Puravila Asha ।",
        "Narahari Tallina Jhala Padapankajalesha ।। 2 ।।"
      ]
    }
  ],
